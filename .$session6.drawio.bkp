            <Array as="points">
              <mxPoint x="1870" y="2000" />
              <mxPoint x="1120" y="2000" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="X4zp6qc-_ZfCin9Pi5VF-11" edge="1" parent="1" source="X4zp6qc-_ZfCin9Pi5VF-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="X4zp6qc-_ZfCin9Pi5VF-18">
