s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 1px solid; inset: auto; clear: none; clip: auto; color: rgb(31, 31, 31); columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: table-cell; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(31, 31, 31) none 0px; overlay: none; padding: 8px 12px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,4,1,0&quot; style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 0px none rgb(31, 31, 31); inset: auto; clear: none; clip: auto; columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: inline; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(31, 31, 31) none 0px; overlay: none; padding: 0px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; margin-top: 0px !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; color: rgb(31, 31, 31);&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Gut erhaltene Waffen, Rüstungsteile oder Artefakte mit starken magischen Signaturen.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 1px solid; inset: auto; clear: none; clip: auto; color: rgb(31, 31, 31); columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: table-cell; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(31, 31, 31) none 0px; overlay: none; padding: 8px 12px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;&lt;span data-path-to-node=&quot;3,4,2,0&quot; style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 0px none rgb(31, 31, 31); inset: auto; clear: none; clip: auto; columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: inline; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(31, 31, 31) none 0px; overlay: none; padding: 0px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; margin-top: 0px !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; color: rgb(31, 31, 31);&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;500 – 2.000+ GP&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="290" width="560" x="1700" y="2440" as="geometry" />
        </mxCell>
        <mxCell id="zLDCwsVYwZEuFYUdiXvF-15" parent="1" style="whiteSpace=wrap;html=1;" value="Bertons Yurt" vertex="1">
          <mxGeometry height="60" width="120" x="2410" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="zLDCwsVYwZEuFYUdiXvF-16" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Das Heulen des Windes und die beißende Kälte lassen nach, sobald ihr die Jurte betretet. Eine kalte Feuerstelle markiert die Mitte des mit Fellen ausgelegten Bodens. Neben der Tür steht eine offene Kiste, die abgepackte Rationen und ein paar andere Gegenstände enthält.“&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="2561" y="2520" as="geometry" />
        </mxCell>
        <mxCell id="zLDCwsVYwZEuFYUdiXvF-17" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Wenn sie die verlassenen Zelte / Feuerstellen untersuchen:&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Keine Kampfspuren:&lt;/b&gt; Es gibt kein Blut, keine zerrissenen Planen und keine Anzeichen eines Überfalls.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Zeichen der Hast:&lt;/b&gt; Alles deutet auf einen extrem schnellen, ungeplanten Aufbruch hin. Ein Kessel mit festgefrorenem Eintopf hängt über kalter Asche. Ein halb geschnitztes Stück Holz liegt neben einem Messer im Schnee. Ein Stapel Feuerholz ist umgekippt und wurde nicht wieder aufgeschichtet.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Spuren im Schnee:&lt;/b&gt; Wer den Boden untersucht (Überlebenskunst/Wahrnehmung), sieht, dass fast alle Fußspuren vom Camp weg in Richtung Norden (oder in die Richtung der neuen Ruine) führen. Der Neuschnee hat sie bereits teilweise verdeckt – der massenhafte Aufbruch muss gestern stattgefunden haben.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="240" width="560" x="620" y="2830" as="geometry" />
        </mxCell>
        <mxCell id="zLDCwsVYwZEuFYUdiXvF-18" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;2&quot;&gt;Optionale Erkundung: Das verlassene Schiff&lt;/h3&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Gespenstische Stille:&lt;/b&gt; Das Schiff liegt fest vertäut und vollkommen intakt in der Bucht, aber es ist komplett verlassen. Kein Licht brennt unter Deck. Nur das Knarren der dicken Taue und das Klatschen des eiskalten Wassers gegen den Rumpf durchbrechen die Stille. Der Neuschnee beginnt bereits, eine unberührte, makellose Schicht auf den Planken zu bilden.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Fertiggestellte Arbeit:&lt;/b&gt; Wer das Deck untersucht, sieht, dass Mila und der Zwerg ganze Arbeit geleistet haben. Die Risse im Holz sind fachmännisch versiegelt, die Segel ordentlich aufgetucht und sturmsicher verzurrt. Das Schiff war bereit für die sofortige Abreise.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Persönliche Details des Aufbruchs:&lt;/b&gt; In der Kajüte oder an Deck finden die Spieler kleine Details, die zeigen, dass die beiden gerufen wurden, kurz nachdem sie fertig waren: Das lederne Werkzeugbündel des Zwergs liegt noch aufgeschlagen auf einer Kiste. Vielleicht hängt auch Milas schwerer, gefütterter Seemannsmantel noch am Haken (was später perfekt erklärt, warum sie in der Eile nicht ihre wärmste Kleidung griff und im Eis ohne den magischen Anhänger erfroren wäre).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,3,0&quot;&gt;&lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Die harte Erkenntnis (DM-Hinweis):&lt;/b&gt; Den Spielern sollte hier klar werden: Ein intaktes Schiff nützt ihnen wenig, wenn niemand an Bord ist, der es sicher durch die tückischen Eisschollen und Strömungen von Eiselcross navigieren kann. Ohne den Zwerg und Mila sitzen sie hier de facto fest. Das erhöht den persönlichen Druck, die beiden zu finden, enorm.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="400" width="560" x="620" y="3070" as="geometry" />
        </mxCell>
        <mxCell id="zLDCwsVYwZEuFYUdiXvF-19" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li&gt;&lt;p data-path-to-node=&quot;2,0,0&quot;&gt;&lt;b data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Atmosphäre &amp;amp; Stimmung:&lt;/b&gt; Gespenstisch, drückend und unnatürlich still. Das sonst laute, raue Söldnerlager wirkt wie eine verlassene Geisterstadt im ewigen Eis. Die Kälte und der Wind fallen durch die Stille viel stärker auf.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,1,0&quot;&gt;&lt;b data-path-to-node=&quot;2,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Bevölkerung (Aktueller Stand):&lt;/b&gt; Fast null. Etwa 95 % der sonstigen Bewohner (Forscher, Glücksritter, Tagelöhner) sind weg.&lt;/p&gt;&lt;ul data-path-to-node=&quot;2,1,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,1,1,0,0&quot;&gt;&lt;i data-path-to-node=&quot;2,1,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Wer noch da ist:&lt;/i&gt; Morgo, The Buyer und eine Handvoll Leute, die körperlich nicht in der Lage waren mitzugehen (ein paar schwer Verwundete, extrem alte Händler).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,1,1,1,0&quot;&gt;&lt;i data-path-to-node=&quot;2,1,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Verhalten der Verbliebenen:&lt;/i&gt; Paranoid, zurückgezogen. Sie verbarrikadieren sich in den Zelten, weil das Lager ohne die Söldner quasi schutzlos gegen wilde Bestien ist.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,2,0&quot;&gt;&lt;b data-path-to-node=&quot;2,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Optik des Camps:&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;2,2,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,2,1,0,0&quot;&gt;Pfade zwischen den Zelten wachsen mit Neuschnee zu.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,2,1,1,0&quot;&gt;Die meisten Feuerstellen sind kalt und vereist.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,2,1,2,0&quot;&gt;Zeichen eines hastigen Aufbruchs überall: fallen gelassene Werkzeuge, nicht zu Ende gekochte Rationen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,3,0&quot;&gt;&lt;b data-path-to-node=&quot;2,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Die zentrale Anlaufstelle:&lt;/b&gt; Das gesamte noch verbliebene &quot;Leben&quot; des Camps konzentriert sich auf das große Kommandozelt von Morgo und dem Buyer. Von außen ist es die einzige beständige Lichtquelle im Lager.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,4,0&quot;&gt;&lt;b data-path-to-node=&quot;2,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Dein Fokus als Spielleiter:&lt;/b&gt; Lass das Camp völlig nutzlos für die Spieler wirken. Es gibt niemanden, den sie anheuern können. Es gibt keine Wachen, die ihnen helfen. Syrinlya bietet in diesem Moment keine Sicherheit, sondern ist nur die Bestätigung dafür, dass die Gruppe komplett auf sich allein gestellt ist.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="460" width="560" x="1510" y="2890" as="geometry" />
        </mxCell>
        <mxCell id="zLDCwsVYwZEuFYUdiXvF-20" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;h4 data-path-to-node=&quot;2&quot; style=&quot;text-align: left;&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Lage In Synrila&lt;/b&gt;&lt;/h4&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="1430" y="2800" as="geometry" />
        </mxCell>
        <mxCell id="zLDCwsVYwZEuFYUdiXvF-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 29px;&quot;&gt;Bumm ist Infected&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;9 tage travel&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;3 long rests&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="410" x="-190" y="2250" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-1" parent="1" style="whiteSpace=wrap;html=1;" value="Buyers Hut" vertex="1">
          <mxGeometry height="60" width="120" x="330" y="3600" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;2,0&quot;&gt;Im Inneren des Kommandozeltes schlägt euch warme, nach Tee und Lampenöl riechende Luft entgegen. Doch die Atmosphäre ist drückend. Das gesamte Zelt wird von einem beklemmenden, blutroten Flackern erhellt. Die Quelle liegt mitten auf dem großen Kartentisch: Ein massiver Silberring, dessen normalerweise unscheinbarer Edelstein nun grellrot pulsiert – wie ein rasender Herzschlag in höchster Not. Begleitet wird das Pochen von einem schrillen, kratzenden Knistern, ein magischer Alarmruf purer Verzweiflung.&lt;/p&gt;&lt;p data-path-to-node=&quot;2,1&quot;&gt;Im harten Flackerlicht tigert Morgo unruhig an der Zeltwand umher. The Buyer sitzt völlig übermüdet in seinem Stuhl, das Gesicht in den Händen vergraben, während sein Feendrache an seinem Hals sitzt und leise, tröstend gurrt. Und bei den beiden steht noch jemand am Tisch.&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="560" x="590" y="3570" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Einzatz Torben&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="586" y="3750" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Als The Buyer euch im Zelteingang bemerkt, bricht er das Gespräch mit dem Fremden abrupt ab und schreckt hoch. Für eine Sekunde blitzt pure Erleichterung in seinen übermüdeten Augen auf. Er atmet hörbar und zittrig aus.&lt;br/&gt;„Bei den Göttern... ihr seid am Leben“, sagt er mit belegter Stimme und erhebt sich mühsam. „Sagt mir, dass ihr das Heilmittel habt. Wir brauchen heute wenigstens eine gute Nachricht...“" vertex="1">
          <mxGeometry height="100" width="610" x="590" y="3820" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-17" edge="1" parent="1" source="YIlWvGcnYdicEOimbji1-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1260" y="4100" />
              <mxPoint x="1260" y="4285" />
            </Array>
            <mxPoint x="1420" y="4285" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-11" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;3. Die Unterbrechung&lt;/b&gt;&#xa;Sobald der neue Spieler gesprochen hat, wendet sich die Aufmerksamkeit der Gruppe zu:&lt;/p&gt;&lt;blockquote data-path-to-node=&quot;5&quot;&gt;&lt;p data-path-to-node=&quot;5,0&quot;&gt;Als The Buyer euch im Zelteingang bemerkt, bricht er das Gespräch mit dem Fremden abrupt ab und schreckt hoch. Für eine Sekunde blitzt pure Erleichterung in seinen übermüdeten Augen auf. Er atmet hörbar und zittrig aus.&lt;/p&gt;&lt;p data-path-to-node=&quot;5,1&quot;&gt;„Bei den Göttern... ihr seid am Leben“, sagt er mit belegter Stimme und erhebt sich mühsam. „Sagt mir bitte, dass ihr das Heilmittel gefunden habt. Wir brauchen heute wenigstens eine gute Nachricht...“&lt;/p&gt;&lt;p data-path-to-node=&quot;5,2&quot;&gt;Noch bevor ihr richtig antworten oder eure Taschen leeren könnt, wischt er sich fahrig über das Gesicht. Sein Blick streift kurz die neue Person am Tisch – eine stumme, entschuldigende Geste, dass ihre Unterhaltung kurz warten muss. Mit einer schweren, fast hilflosen Handbewegung deutet er auf die Mitte der ausladenden Tischplatte.&lt;/p&gt;&lt;p data-path-to-node=&quot;5,3&quot;&gt;„Aber egal, was ihr mir gleich berichtet... kommt erst einmal her und seht euch das an.“&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="310" width="560" x="570" y="3945" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-12" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;2,0&quot;&gt;Als The Buyer euch im Zelteingang bemerkt, bricht er das Gespräch mit dem Fremden abrupt ab. Die pure Erschöpfung in seinem Gesicht weicht für eine Sekunde aufrichtiger Erleichterung.&lt;/p&gt;&lt;p data-path-to-node=&quot;2,1&quot;&gt;„Bei den Göttern... ihr seid am Leben“, sagt er mit belegter Stimme und erhebt sich mühsam. Er sieht euch erwartungsvoll an. „Bitte sagt mir, dass ihr es gefunden habt... wir brauchen heute wenigstens eine gute Nachricht.“&lt;/p&gt;&lt;p data-path-to-node=&quot;2,2&quot;&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="560" x="580" y="4230" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-13" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div class=&quot;container&quot;&gt;&lt;div class=&quot;markdown markdown-main-panel stronger enable-updated-hr-color&quot; id=&quot;model-response-message-contentr_e3b2e41cfa9dd8ff&quot; aria-live=&quot;polite&quot; aria-busy=&quot;false&quot; dir=&quot;ltr&quot; style=&quot;--animation-duration: 400ms; --fade-animation-function: ease-out;&quot;&gt;&lt;p data-path-to-node=&quot;1&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;3. Die Unterbrechung &amp;amp; Die neue Krise&lt;/b&gt;&lt;/p&gt;&lt;blockquote data-path-to-node=&quot;2&quot;&gt;&lt;p data-path-to-node=&quot;2,0&quot;&gt;The Buyer nimmt das Heilmittel mit zittrigem Ausatmen entgegen, verstaut die Ampullen zügig in der steinernen Transportkiste auf dem Tisch und verschließt sie sicher.&lt;/p&gt;&lt;p data-path-to-node=&quot;2,1&quot;&gt;Sofort wandert sein Blick zurück zu dem erbarmungslos rot flackernden Ring. Er nickt der neuen Person am Tisch kurz zu – ein Zeichen, dass ihre vorherige Diskussion jetzt endgültig zweitrangig ist – und wendet sich ernst an euch.&lt;/p&gt;&lt;p data-path-to-node=&quot;2,2&quot;&gt;„Ich bin froh, dass ihr am Leben seid... aber kommt her und seht euch das an. Wir haben direkt das nächste gewaltige Problem.“&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;0&quot;&gt;Das Gespräch (Informationen für die Spieler):&lt;/b&gt;&lt;br&gt;The Buyer erklärt der Gruppe nun hastig die aktuelle, katastrophale Lage. Nutze diese Punkte flexibel im Dialog:&lt;/p&gt;&lt;ul data-path-to-node=&quot;4&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,0,0&quot;&gt;&lt;b data-path-to-node=&quot;4,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Personalmangel:&lt;/b&gt; Der Außenposten ist aktuell fast leer. Ein Grosteil der Ansessigen bewoner des aussenposten sind waren bei der ersten Expidition dabai und&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Beim letzten Versorgungslauf sind viele Arbeiter zurück aufs Festland nach Palebank Village gereist.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,1,0&quot;&gt;&lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Expedition:&lt;/b&gt; Der Großteil der verbliebenen fähigen Leute ist ins Eis aufgebrochen. Sie haben tief im Schnee ein neues, unberührtes Labor aus der Zeit von &lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;157&quot;&gt;Aeor&lt;/b&gt; entdeckt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,2,0&quot;&gt;&lt;b data-path-to-node=&quot;4,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Alarm:&lt;/b&gt; Der Ring auf dem Tisch ist kein Kommunikator, sondern ein magischer Lebensmonitor. Er gehört zu einem Mitglied dieser Labor-Expedition (vermutlich Morgo).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,3,0&quot;&gt;&lt;b data-path-to-node=&quot;4,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Bedeutung:&lt;/b&gt; Das Flackern bedeutet, dass der Träger nicht einfach in Not ist, sondern in diesem Moment im Sterben liegt oder ihm massiv die Lebenskraft entzogen wird.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,3,0&quot;&gt;Es Befinden sich nurnoch einzelene verletzte die nicht in der lage sind auf eine rescue mission zu gehen und welche die es für zu riskant erachten&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="560" x="550" y="4380" as="geometry" />
        </mxCell>
        <mxCell id="O8MarJ5i8mJ102Qb0Z8C-3" edge="1" parent="1" source="YIlWvGcnYdicEOimbji1-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="O8MarJ5i8mJ102Qb0Z8C-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-14" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;0&quot;&gt;Die vermisste Expedition (Die 20-köpfige Gruppe)&lt;/h3&gt;&lt;p data-path-to-node=&quot;1&quot;&gt;Diese Gruppe ist das eigentliche Hauptproblem. Sie sollten eine neu entdeckte Struktur oder Anomalie sichern, haben aber den Kontakt verloren.&lt;/p&gt;&lt;ul data-path-to-node=&quot;2&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,0,0&quot;&gt;&lt;b data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Größe der Gruppe:&lt;/b&gt; Etwa 20 Personen. Ein gemischter Trupp aus Arbeitern für schweres Gerät, ein paar Gelehrten/Analysten und einem Geleitschutz aus Söldnern.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,1,0&quot;&gt;&lt;b data-path-to-node=&quot;2,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Aufbruch:&lt;/b&gt; Vor genau 10 Tagen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,2,0&quot;&gt;&lt;b data-path-to-node=&quot;2,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Fortbewegung:&lt;/b&gt; Zu Fuß, mit Karren oder schwerem Gepäck.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,3,0&quot;&gt;&lt;b data-path-to-node=&quot;2,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Zielort (Die neue Fundstelle):&lt;/b&gt; Liegt etwa 5&lt;b data-path-to-node=&quot;2,3,0&quot; data-index-in-node=&quot;42&quot;&gt;&amp;nbsp;Tagesreisen zu Fuß&lt;/b&gt; vom aktuellen Kommandozelt entfernt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,4,0&quot;&gt;&lt;b data-path-to-node=&quot;2,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Zeitlinie:&lt;/b&gt; Da die Fundstelle nur 2 Tage entfernt ist, bedeutet der 10-tägige Aufbruch, dass die Expedition bereits &lt;b data-path-to-node=&quot;2,4,0&quot; data-index-in-node=&quot;119&quot;&gt;8 Tage vor Ort&lt;/b&gt; war. Sie haben erfolgreich ein Lager aufgeschlagen und tagelang gearbeitet, bevor plötzlich etwas schiefging und der geplante Lagebericht ausblieb.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h3 data-path-to-node=&quot;4&quot;&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="320" width="560" x="1380" y="3660" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-15" edge="1" parent="1" source="YIlWvGcnYdicEOimbji1-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.004;entryY=0.431;entryDx=0;entryDy=0;entryPerimeter=0;" target="YIlWvGcnYdicEOimbji1-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-21" edge="1" parent="1" source="YIlWvGcnYdicEOimbji1-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="YIlWvGcnYdicEOimbji1-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-19" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;2&quot;&gt;Der Zwillingsring auf dem Tisch ist kein Panikknopf oder Kommunikationsmittel. Er ist ein magischer &lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;100&quot;&gt;Vital- oder Essenz-Monitor&lt;/b&gt;, der tief mit der angeborenen Lebenskraft seines Trägers verbunden ist.&lt;/p&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Funktionsweise:&lt;/b&gt; Jedes lebende Wesen besitzt eine natürliche, innere Magie – einen Funken, der den Körper am Leben hält. Der Ring misst diesen konstanten Fluss. Solange der Träger gesund ist, bleibt der Stein matt und unauffällig.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Auslöser:&lt;/b&gt; Der Ring schlägt nur dann Alarm, wenn diese lebenserhaltende Magie drastisch abfällt oder gewaltsam entzogen wird. Das rote Pulsieren bedeutet, dass die innere Energie einen absolut kritischen Punkt erreicht hat oder gerade völlig erlischt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Die erschreckende Bedeutung:&lt;/b&gt;&amp;nbsp;Orvo (oder wer auch immer den Ring trägt) hat diesen Alarm &lt;i data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;89&quot;&gt;nicht&lt;/i&gt; bewusst ausgelöst. Er konnte vermutlich gar nicht mehr handeln. Das unregelmäßige, rasende Pulsieren auf dem Tisch bedeutet schlichtweg: Der Träger verblutet gerade, wird von einer dunklen Macht ausgesaugt oder liegt in diesem exakten Moment im Sterben.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="290" width="560" x="1420" y="4180" as="geometry" />
        </mxCell>
        <mxCell id="O8MarJ5i8mJ102Qb0Z8C-4" edge="1" parent="1" source="YIlWvGcnYdicEOimbji1-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="O8MarJ5i8mJ102Qb0Z8C-1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3130" y="4130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="YIlWvGcnYdicEOimbji1-20" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;0&quot;&gt;Essenz-Resonanzringe (Zwillingsringe)&lt;/h3&gt;&lt;p data-path-to-node=&quot;1&quot;&gt;&lt;i data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;Wundervoller Gegenstand (Ring), selten&lt;/i&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;Ein Paar massiver Silberringe. Das dicke Metallband jedes Rings ist von feinen, verschlungenen Runen überzogen. Im Zentrum prangt ein ungewöhnlich großer Edelstein, der im Normalzustand matt, milchig und völlig unscheinbar wirkt.&lt;/p&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;0&quot;&gt;Eigenschaften:&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;4&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,0,0&quot;&gt;&lt;b data-path-to-node=&quot;4,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Magische Symbiose:&lt;/b&gt; Diese Ringe werden immer als Paar geschmiedet. Sie sind über jede Entfernung hinweg magisch miteinander verbunden, solange sich beide Ringe auf derselben Existenzebene befinden.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,1,0&quot;&gt;&lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Vital-Monitor:&lt;/b&gt; Sobald ein Lebewesen den Ring anlegt, verknüpfen sich die Runen im Inneren des Bandes passiv mit der angeborenen Lebensenergie (der Essenz) des Trägers. Solange der Träger am Leben und sein Zustand stabil ist, bleibt der Ring unauffällig.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,2,0&quot;&gt;&lt;b data-path-to-node=&quot;4,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Kritischer Alarm:&lt;/b&gt; Fällt die Lebenskraft des Trägers in einen absolut kritischen, lebensbedrohlichen Bereich – beispielsweise wenn er dem Tode nahe ist (0 Trefferpunkte), massiv verblutet oder ihm durch feindliche Magie gewaltsam Lebensessenz entzogen wird –, schlägt der Partner-Ring sofort Alarm.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,3,0&quot;&gt;&lt;b data-path-to-node=&quot;4,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Das Signal:&lt;/b&gt; Der Edelstein des anderen Rings füllt sich mit einem Licht, das wie eingesperrtes, flüssiges Feuer wirkt. Er stößt ein grellrotes, panisches Flackern aus und pulsiert in einem rasenden, unregelmäßigen Rhythmus, der an einen Herzschlag in höchster Not erinnert. Begleitet wird dies von einem schrillen, kratzenden Knistern, das wie brechendes Glas in den Ohren summt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,4,0&quot;&gt;&lt;b data-path-to-node=&quot;4,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Ende der Verbindung:&lt;/b&gt; Der Alarm hält so lange an, bis der Zustand des verletzten Trägers stabilisiert wurde. Stirbt der Träger jedoch, erlischt das rote Licht abrupt. Der Edelstein des Gegenstücks läuft in diesem Moment tiefschwarz an und zerspringt mit einem leisen Knacken, wodurch die Magie der Ringe für immer zerstört wird.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="520" width="560" x="2335" y="3870" as="geometry" />
        </mxCell>
        <mxCell id="f76DgSI6AV0PdkqyqMgt-1" parent="1" style="whiteSpace=wrap;html=1;" value="Synrelas Stall&lt;div&gt;Eingang&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="300" y="4940" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Wenn Die Spieler nach Reitiern fragen antowrtet Morgo der Gruppe und fuert sie zu einer Verstekten hölle, ansonnsten wenn nicht gefragt wird werden sie so dahin gefuert" vertex="1">
          <mxGeometry height="30" width="340" x="590" y="4850" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-4" edge="1" parent="1" source="LaVOeRUoyGzRE99gaNWh-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="LaVOeRUoyGzRE99gaNWh-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div class=&quot;container&quot;&gt;&lt;div class=&quot;markdown markdown-main-panel stronger enable-updated-hr-color&quot; id=&quot;model-response-message-contentr_c0cded790e821da3&quot; aria-live=&quot;polite&quot; aria-busy=&quot;false&quot; dir=&quot;ltr&quot; style=&quot;--animation-duration: 400ms; --fade-animation-function: ease-out;&quot;&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Abgelegener Ort:&lt;/b&gt; Morgo, die Werbärin, führt die Gruppe zielstrebig an den äußersten, ungenutzten Rand des Lagers, fernab der restlichen Zelte und neugierigen Blicke.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Scheinbare Sackgasse:&lt;/b&gt; Der Weg endet abrupt vor einer massiven, schroffen Eiswand, die wie eine völlig natürliche, unpassierbare Sackgasse am Rande des Gebirges wirkt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Perfekte Tarnung:&lt;/b&gt; Ohne magische Hilfsmittel oder Morgos explizite Führung würde niemand auf die Idee kommen, dass sich hinter diesem Felsmassiv ein geheimer Bereich verbirgt.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Die Illusions-Barriere&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Physische Illusion:&lt;/b&gt; Die Eiswand ist in Wahrheit eine mächtige, magische Illusion, die nicht nur täuschend echt aussieht, sondern sich bei Berührung durch Unbefugte auch wie massiver, eiskalter Frost anfühlt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Morgos Monopol:&lt;/b&gt; Nur Morgo hat die Autorität und den Zugang zu diesem Ort, was sie der Gruppe mit einem stolzen, tiefen Brummen auch deutlich macht.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Schlüssel:&lt;/b&gt; Um die Barriere zu durchdringen, nutzt sie ihren persönlichen Ring, der als magischer Schlüssel für diese spezifische Illusion fungiert.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;6&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;Das Öffnen des Eingangs&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;&lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Aktivierung:&lt;/b&gt; Morgo legt ihre breite Hand mitsamt dem Ring flach gegen die eisige Oberfläche, woraufhin die Magie der Wand sofort auf das Artefakt reagiert.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;&lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Lautloses Verschwinden:&lt;/b&gt; Anstatt aufzubrechen, verliert der harte Fels lautlos seine Struktur und verschwimmt wie dichter Nebel, der sich in der kalten Luft auflöst.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,2,0&quot;&gt;&lt;b data-path-to-node=&quot;7,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Der erste Eindruck:&lt;/b&gt; Der magische Schleier weicht zurück und gibt den Blick auf eine gewaltige Höhle frei, aus der der Gruppe sofort der Geruch von feuchtem Fell und eine völlig unerwartete, wohlige Wärme entgegenschlägt.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="500" width="560" x="530" y="4960" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Schlüssel der Illusion:&lt;/b&gt; Dieses Amulett dient als exklusiver magischer Schlüssel für die verborgene Warg-Höhle des Außenpostens. Nähert sich der Träger der illusionären Eiswand, beginnen die Bernstein-Augen des Bären sanft zu glimmen. Wird das Amulett gegen den magischen Fels gedrückt, löst sich die Barriere in einem Umkreis von etwa drei Metern lautlos wie dichter Nebel auf und gibt den Durchgang frei.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Zeichen des Leitwolfs:&lt;/b&gt; Das Amulett ist nicht nur ein Schlüssel für die Tür, sondern auch für die Tiere. Es ist magisch mit der Aura des Tiermeisters (Morgo) verknüpft. Solange ein Charakter diese Kette offen trägt, erkennen die abgerichteten Schneewarge in der Höhle ihn nicht als Eindringling, sondern als autorisierten Rudelführer an und verhalten sich gehorsam, anstatt anzugreifen.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="200" width="560" x="1370" y="5000" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;blockquote data-path-to-node=&quot;3&quot;&gt;&lt;p data-path-to-node=&quot;3,0&quot;&gt;Sobald sich der magische Nebel lichtet und ihr eintreten könnt, findet ihr euch in einer erstaunlich geräumigen, aber rein zweckmäßigen Naturhöhle wieder. Die klirrende Kälte des Eises bleibt schlagartig hinter euch. Entlang der rauen Felswände pulsieren faustgroße Kristalle in einem warmen, kupferfarbenen Licht und erfüllen die gesamte Kaverne mit einer wohligen, fast zimmerwarmen Hitze.&lt;/p&gt;&lt;p data-path-to-node=&quot;3,1&quot;&gt;Die Einrichtung ist schlicht und pragmatisch. Auf der linken Seite reihen sich massive Buchten aneinander, die aus dicken, unbehauenen Holzstämmen gezimmert sind. Darin ruhen die gewaltigen Schneewarge auf dicken, weichen Pelzbetten. Auf der gegenüberliegenden Seite der Höhle fällt euer Blick auf einen schweren, tief in den Fels gebauten Lagerschuppen, der mit seiner dicken Tür eher an einen kleinen Bunker erinnert.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="560" x="470" y="5500" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-11" edge="1" parent="1" source="LaVOeRUoyGzRE99gaNWh-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="LaVOeRUoyGzRE99gaNWh-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Pragmatisches Design:&lt;/b&gt; Die Höhle verzichtet auf jeglichen Luxus und ist rein funktional eingerichtet; sie dient ausschließlich dem Schutz und der Vorbereitung der Tiere und Ausrüstung.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Wärmekristalle:&lt;/b&gt; Die fest in den Fels geschlagenen Kristalle fungieren als magische Heizungen, die nicht nur Licht spenden, sondern die Warge auch vor dem Auskühlen bewahren.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Massive Holzställe:&lt;/b&gt; Im starken Kontrast zu den leichten Zelten des Außenpostens draußen, sind die Buchten der Warge aus extrem massiven Holzstämmen gebaut, um selbst der enormen Kraft eines aufgewühlten Wargs standhalten zu können.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,3,0&quot;&gt;&lt;b data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Schlafplätze:&lt;/b&gt; Die Tiere müssen nicht auf dem harten, kalten Stein ruhen, sondern schlafen auf üppigen Schichten aus dichten Tierfellen und Stroh, die als komfortable Betten dienen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,4,0&quot;&gt;&lt;b data-path-to-node=&quot;5,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Bereitstehende Schlitten:&lt;/b&gt; Direkt in der Nähe der Ställe sind die acht robusten Kufenschlitten samt ihrer Ledergeschirre aufgereiht, fertig für den sofortigen Einsatz.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,5,0&quot;&gt;&lt;b data-path-to-node=&quot;5,5,0&quot; data-index-in-node=&quot;0&quot;&gt;Der gesicherte Lagerschuppen:&lt;/b&gt; Im hinteren Bereich der Höhle gibt es einen besonders gut befestigten Raum, der durch dicke Holzwände und eine schwere Tür gesichert ist.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,6,0&quot;&gt;&lt;b data-path-to-node=&quot;5,6,0&quot; data-index-in-node=&quot;0&quot;&gt;Notfall-Vorräte:&lt;/b&gt; Dieser Bunker-Schuppen fungiert als sicheres Depot für kritische Ausrüstung und enthält Dinge wie Heiltränke, Notrationen, wärmende Decken und Ersatzteile für die Schlitten, falls eine Expedition schnell aufbrechen muss.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="350" width="560" x="510" y="5700" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-7" parent="1" style="whiteSpace=wrap;html=1;" value="Sznrellas Stall&lt;div&gt;Innen&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="280" y="5460" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-9" parent="1" style="whiteSpace=wrap;html=1;" value="Notfall lager" vertex="1">
          <mxGeometry height="60" width="120" x="1400" y="5460" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-10" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div class=&quot;container&quot;&gt;&lt;div class=&quot;markdown markdown-main-panel stronger enable-updated-hr-color&quot; id=&quot;model-response-message-contentr_1d0dbc9ef0059707&quot; aria-live=&quot;polite&quot; aria-busy=&quot;false&quot; dir=&quot;ltr&quot; style=&quot;--animation-duration: 400ms; --fade-animation-function: ease-out;&quot;&gt;&lt;blockquote data-path-to-node=&quot;3&quot;&gt;&lt;p data-path-to-node=&quot;3,0&quot;&gt;Wenn ihr euren Blick auf den hinteren Teil der Höhle richtet, seht ihr, dass dieser Schuppen weitaus größer ist, als es auf den ersten Blick schien. Es ist ein massiver, bunkerartiger Vorbau, dessen Wände aus dicken Stämmen bestehen und der tief in den natürlichen Fels hineinreicht.&lt;/p&gt;&lt;p data-path-to-node=&quot;3,1&quot;&gt;Als Morgo die schwere, mit Eisen beschlagene Holztür aufstößt, offenbart sich ein überraschend weitläufiges Lager. Der Geruch von getrocknetem Fleisch, altem Leinen und Kräutern liegt schwer in der Luft. Bis unter die Decke stapeln sich hier systematisch geordnete Kisten, Fässer und dicke Stoffbündel – ein kompletter, autarker Überlebensvorrat für den schlimmsten Fall.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Notizen: Der Inhalt des Notfall-Lagers&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Zweck des Bunkers:&lt;/b&gt; Dieser ausladende Raum ist nicht für den alltäglichen Gebrauch gedacht, sondern dient als absolute Notreserve des Außenpostens, falls die lebenswichtigen Versorgungslieferungen vom Festland (Palebank Village) durch Stürme oder Katastrophen komplett ausfallen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Schutz vor der Kälte:&lt;/b&gt; In großen Regalen stapeln sich Berge von extrem dicken Tierpelzen und schweren Wolldecken, die darauf ausgelegt sind, Personen selbst bei den eisigsten Temperaturen vor dem Erfrieren zu bewahren.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Provisorische Unterkünfte:&lt;/b&gt; Eine ganze Ecke des Bunkers ist mit robusten Holzstangen, dicken Lederplanen und starken Seilen belegt, die als Baumaterial dienen, um in der Wildnis schnell winddichte, provisorische Zelte errichten zu können.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,3,0&quot;&gt;&lt;b data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Notrationen:&lt;/b&gt; Zahlreiche versiegelte Fässer und Kisten beinhalten lang haltbare Nahrung, vor allem große Mengen an stark gesalzenem, getrocknetem Fleisch und hartem Zwieback, um die Truppe notfalls wochenlang am Leben zu halten.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,4,0&quot;&gt;&lt;b data-path-to-node=&quot;5,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Medizinische Versorgung:&lt;/b&gt; Auf einer speziellen Werkbank liegen säuberlich sortierte Erste-Hilfe-Materialien bereit, darunter unzählige saubere Stoffverbände, Holzschienen für Knochenbrüche sowie eine kleine, gut gesicherte Truhe, in der sich einige kostbare Heiltränke für lebensbedrohliche Verletzungen befinden.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="560" x="1540" y="5510" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Ab Hier Soll The Bueryer Der Gruppe Eine box mit zehn heiltränken übergeben und spättestens jetzt nochmal einen zwillings rind an entweder Arellius oder Patates (Diese Solle Iher Blut auf den Kristall Geben und etwas magie in den ring mit dem blut fieiessen lassen)" vertex="1">
          <mxGeometry height="30" width="620" x="490" y="6060" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Jeder Wagen kann max 3-4 spieler tragen ausgenummen bumm kann max mit einer andern leichten person auf einen wagen Morgo ueberlasst den spielern 5 schlitten mit je 2 Wargs mit dem Hinweis das die wargs Seher gut trainirt sind&amp;nbsp;&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="640" x="470" y="6110" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-16" edge="1" parent="1" source="LaVOeRUoyGzRE99gaNWh-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1670" y="6410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4w4CXxoGXee6WxAI3u5W-2" edge="1" parent="1" source="LaVOeRUoyGzRE99gaNWh-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="4w4CXxoGXee6WxAI3u5W-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w4CXxoGXee6WxAI3u5W-4" edge="1" parent="1" source="LaVOeRUoyGzRE99gaNWh-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="6610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-14" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div class=&quot;container&quot;&gt;&lt;div class=&quot;markdown markdown-main-panel stronger enable-updated-hr-color&quot; id=&quot;model-response-message-contentr_8aa8c2df7b6567be&quot; aria-live=&quot;polite&quot; aria-busy=&quot;false&quot; dir=&quot;ltr&quot; style=&quot;--animation-duration: 400ms; --fade-animation-function: ease-out;&quot;&gt;&lt;blockquote data-path-to-node=&quot;3&quot;&gt;&lt;p data-path-to-node=&quot;3,0&quot;&gt;Nach Stunden rasanter Fahrt durch den Schnee bemerkt ihr abseits eurer Route eine Unregelmäßigkeit: Unter einer massiven Schneewehe pulsiert ein schwaches, panisches Lichtflackern.&lt;/p&gt;&lt;p data-path-to-node=&quot;3,1&quot;&gt;Als ihr den Schnee eilig beiseiteschiebt, findet ihr Mila. Sie ist halb erfroren und übersät mit entsetzlichen, riesigen Kratz- und Bisswunden. Sie lebt nur noch durch den leuchtenden Anhänger an ihrem Hals. Der Stein flackert wild und gibt ein angestrengtes, hohes Summen von sich. Seine Magie hat sich in ihre Wunden gefressen und das Blut zu magischem Bernstein kristallisiert, um sie krampfhaft am Verbluten zu hindern. Ihr Atem ist extrem flach, und das Artefakt steht kurz davor, hörbar auszubrennen.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Notizen:&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Entdeckung:&lt;/b&gt; Hohe Passive Wahrnehmung ist nötig, um das schwache Flackern bei der schnellen Schlittenfahrt im Schneegestöber zu sehen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Zustand:&lt;/b&gt; Mila ist mechanisch bei 0 Trefferpunkten, aber künstlich durch den Anhänger stabilisiert. Die Wunden stammen unmissverständlich von einem gewaltigen Monster.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Das Artefakt am Limit:&lt;/b&gt; Es wärmt sie nicht, es stoppt nur das Verbluten. Die magische Blut-Kristallisierung sieht schmerzhaft und unnatürlich aus.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,3,0&quot;&gt;&lt;b data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Spieler-Aktion erforderlich:&lt;/b&gt; Die Gruppe muss sofort Heilmagie oder Tränke (z.B. aus dem Notfall-Bunker) anwenden, um sie zu retten.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,4,0&quot;&gt;&lt;b data-path-to-node=&quot;5,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Bruch des Steins:&lt;/b&gt; Sobald die Spieler Milas Sterbeprozess durch eigene Heilung stoppen, registriert die Magie das. Das Licht dimmt herab, woraufhin der völlig überlastete Stein leise zerspringt und nutzlos wird. Das magische Eis in ihren Wunden schmilzt daraufhin zu normalen Blutkrusten.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="480" width="560" x="460" y="6360" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-15" parent="1" style="whiteSpace=wrap;html=1;" value="Mila Fundort" vertex="1">
          <mxGeometry height="60" width="120" x="270" y="6370" as="geometry" />
        </mxCell>
        <mxCell id="X1xFif0z46ewRQQArJEh-3" edge="1" parent="1" source="LaVOeRUoyGzRE99gaNWh-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="LaVOeRUoyGzRE99gaNWh-18" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-17" parent="1" style="whiteSpace=wrap;html=1;" value="Gnoll Attact" vertex="1">
          <mxGeometry height="60" width="120" x="1670" y="6380" as="geometry" />
        </mxCell>
        <mxCell id="LaVOeRUoyGzRE99gaNWh-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font color=&quot;#ff0000&quot;&gt;2 Gnoll Flesch Gnawer&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;1 Pack Lord&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;1 Gnoll Crackler&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="140" x="1690" y="6490" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-6" edge="1" parent="1" source="X1xFif0z46ewRQQArJEh-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="U28gEqxTcT6NedzWE8BR-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="X1xFif0z46ewRQQArJEh-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;Mila schlägt die Augen auf. Sie ist traumatisiert, friert erbärmlich und krallt sich an die Spieler. Sie kennt keinen &quot;Tamer&quot;, sie weiß nur, dass das, was dort draußen ist, kein normaler Monsterangriff war.&lt;/p&gt;&#xa;&lt;ul&gt;&#xa;&lt;li&gt;&lt;strong&gt;Die grausige Wahrheit:&lt;/strong&gt; &lt;em&gt;&quot;Da waren... Bestien. Aber sie waren nicht wild. Sie haben uns nicht einfach angefallen.&quot;&lt;/em&gt; Sie hustet schwer. &lt;em&gt;&quot;Sie haben uns in eine Falle getrieben. Flankiert.&quot;&lt;/em&gt;&lt;br&gt;&#xa;&lt;/li&gt;&#xa;&lt;li&gt;&lt;strong&gt;Die Gestalt:&lt;/strong&gt; &lt;em&gt;&quot;Jemand hat sie befehligt. Eine Gestalt... ich konnte das Gesicht im Schneesturm nicht sehen. Aber als sie die Hand hob, haben die Kreaturen gestoppt. Als sie auf Orvo zeigte... haben sie ihn einfach zerrissen. Wer auch immer das war... diese Person kontrolliert die Monster.&quot;&lt;/em&gt;&lt;br&gt;&#xa;&lt;/li&gt;&#xa;&lt;li&gt;&lt;strong&gt;Das Opfer des Zwergs:&lt;/strong&gt; Sie weint bitterlich, als sie erzählt, wie der Zwerg sich schwer blutend in einen felsigen Engpass stellte und mit seiner Waffe den Eisüberhang zum Einsturz brachte, um die Bestien von ihr abzuschirmen, damit sie Hilfe holen konnte.&lt;/li&gt;&#xa;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="360" width="560" x="820" y="6970" as="geometry" />
        </mxCell>
        <mxCell id="X1xFif0z46ewRQQArJEh-2" edge="1" parent="1" source="LaVOeRUoyGzRE99gaNWh-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.448;entryY=0.011;entryDx=0;entryDy=0;entryPerimeter=0;" target="X1xFif0z46ewRQQArJEh-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w4CXxoGXee6WxAI3u5W-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;1&quot;&gt;Mila schlägt blinzelnd die Augen auf. Sie zittert unkontrolliert vor Kälte, doch statt reiner Panik spiegelt sich ein verzweifelter, fast naiver Funke Hoffnung in ihren Augen. Sie klammert sich an die Spieler und fleht sie sofort an, anstatt aufzugeben.&lt;/p&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Das verlassene Dorf &amp;amp; Das Labor:&lt;/b&gt;&#xa;Sie hustet schwach, versucht aber hastig, die Worte herauszustoßen: „Ihr müsst zum Zielort... den Ruinen der alten, unbewohnten Siedlung. Die erste Expedition... sie haben dort nach Tagen der Suche einen Zugang zu einem riesigen Aeor-Laborkomplex tief im Eis freigelegt... Da müssen die anderen sein!“&lt;/p&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;0&quot;&gt;Der Überfall der Scharen:&lt;/b&gt;&#xa;„Als wir uns dem Dorf nähern wollten, kamen diese Bestien aus dem Schneesturm. So viele... eine ganze Schar von Monstern! Sie haben uns sofort umzingelt.“ Sie schluckt schwer, klammert sich fester an eure Rüstungen. „Aber Bari und Orvo... sie haben mich beschützt! Bari hat mir befohlen, sofort vorwärts ins Dorf zu laufen, um die Ausgrabungstruppe zu warnen und Hilfe zu holen.“&lt;/p&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Desperates Hoffen vs. Die grausame Realität:&lt;/b&gt;&#xa;„Bitte, ihr müsst sie da herausholen!“, weint sie und blickt euch flehend an. „Bari ist unglaublich stark, und Orvo weiß, wie man sich verteidigt! Sie halten bestimmt noch durch und warten auf mich. Ihr könnt sie noch retten, ihr müsst nur schnell sein!“&lt;/p&gt;&lt;blockquote data-path-to-node=&quot;5&quot;&gt;&lt;p data-path-to-node=&quot;5,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Hinweis für die Atmosphäre:&lt;/b&gt;&#xa;Während Mila mit rührender Leichtgläubigkeit fest daran glaubt, dass ihre Freunde noch am Leben sind, spricht ihr eigener Zustand eine andere Sprache. Die schrecklichen Kratz- und Bisswunden an ihrem Körper und die schiere Menge an Blut, die das Artefakt kristallisieren musste, machen den Spielern unmissverständlich klar: Wenn Mila beim bloßen &lt;i data-path-to-node=&quot;5,0&quot; data-index-in-node=&quot;386&quot;&gt;Fliehen&lt;/i&gt; schon fast zerfetzt wurde, haben Bari und Orvo im Zentrum dieses Monster-Schwarms so gut wie keine Überlebenschance gehabt.&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="470" width="560" x="200" y="6970" as="geometry" />
        </mxCell>
        <mxCell id="4w4CXxoGXee6WxAI3u5W-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Morgo Gibt Der Gruppe Noch mehere Schlafsakk ähnliche felle mit der bitte/aussage wenn sie ueberlebende finden sie zu verarsten und mit einem der schlitten zurück zu schicken" vertex="1">
          <mxGeometry height="30" width="700" x="470" y="6160" as="geometry" />
        </mxCell>
        <mxCell id="4w4CXxoGXee6WxAI3u5W-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;1&quot;&gt;Amulett der Frostphönix-Träne&lt;/h3&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;i data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Wundervoller Gegenstand (Halskette), selten (Erbstück)&lt;/i&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;Diese feine, filigrane Halskette ist ein wertvolles Familienerbstück, das Mila vor ihrer Abreise geschenkt wurde. Der Anhänger hat die Form einer eisblauen Träne – geschliffen aus einem unbekannten, kühlen Kristall –, die von zwei kunstvoll geschmiedeten Schwingen eines Eisphönix aus Silber umschlossen wird. Im Normalzustand glimmt der Stein in einem sanften, beruhigenden Blauton.&lt;/p&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Eigenschaften bei der Identifikation:&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Verzweifelte Lebenswacht:&lt;/b&gt; Wenn der Träger auf 0 Trefferpunkte fällt und zu sterben droht, aktiviert sich die uralte Schutzmagie des Amuletts. Es erschafft keine schützende Barriere nach außen, sondern bekämpft den Tod direkt im Körper des Trägers.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Magische Frostversiegelung:&lt;/b&gt; Die Magie des Eisphönix frisst sich tief in offene, lebensbedrohliche Wunden und lässt das austretende Blut sofort zu einer Art magischem Eis gefrieren. Dieser brutale Prozess stoppt den Blutverlust augenblicklich und hält den Träger künstlich am Leben.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Das absolute Limit:&lt;/b&gt; Während das Amulett gegen den Tod ankämpft, flackert der Stein wild und unregelmäßig in einem panischen Weißblau, während das Artefakt ein hohes, gequältes Summen von sich gibt. Das Amulett ist nicht für solch massive Schäden gedacht und brennt seine gespeicherte Magie rasend schnell aus, um den Körper zu stabilisieren.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,3,0&quot;&gt;&lt;b data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Riss im Kristall:&lt;/b&gt; Sobald der Träger durch externe Heilmagie oder einen Heiltrank gerettet wird, registriert das Amulett, dass der akute Sterbeprozess gestoppt wurde. Das Licht dimmt langsam herab, woraufhin der völlig überlastete Stein mit einem leisen, hellen Knacken einen tiefen Riss bekommt. Seine rettende Magie ist damit erloschen (oder muss für sehr lange Zeit ruhen), doch das Amulett selbst zerspringt nicht, sondern bleibt als gezeichnetes Erinnerungsstück erhalten. In diesem Moment schmilzt das magische Eis in den Wunden harmlos zu normalen Blutkrusten zusammen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="510" width="560" x="-520" y="6370" as="geometry" />
        </mxCell>
        <mxCell id="4w4CXxoGXee6WxAI3u5W-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der magische Puffer (Startwert 20):&lt;/b&gt; Zu Beginn des Kampfes hat das Amulett noch eine Magiereserve von &lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;101&quot;&gt;20 Punkten&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Das Schwinden der Magie (Der Abzug):&lt;/b&gt; Am Ende jeder Kampfrunde (auf Initiative 0) würfelst du einen &lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;99&quot;&gt;W4&lt;/b&gt; (oder W6, falls du etwas mehr Druck willst) und ziehst das Ergebnis von den 20 Punkten ab.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,2,0&quot;&gt;&lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Atmosphäre am Tisch:&lt;/b&gt; Du kannst den Abzug nutzen, um den Spielern den Ernst der Lage zu beschreiben. &lt;i data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;100&quot;&gt;„Der Stein verliert weitere 3 Punkte seiner Kraft. Das panische Flackern wird schwächer und das schützende Eis in Milas Wunden beginnt an den Rändern leicht zu tauen.“&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,3,0&quot;&gt;&lt;b data-path-to-node=&quot;8,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Bruch (bei 0):&lt;/b&gt; Erst wenn der Wert auf &lt;b data-path-to-node=&quot;8,3,0&quot; data-index-in-node=&quot;42&quot;&gt;0 oder weniger&lt;/b&gt; fällt, gibt die überlastete Magie endgültig auf. Der Kristall bekommt seinen Riss, das rettende Eis schmilzt schlagartig zu Blutkrusten, und Mila muss ab ihrer nächsten Runde ganz reguläre &lt;b data-path-to-node=&quot;8,3,0&quot; data-index-in-node=&quot;246&quot;&gt;Todesrettungswürfe (Death Saves)&lt;/b&gt; machen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,4,0&quot;&gt;&lt;b data-path-to-node=&quot;8,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Rettung:&lt;/b&gt; Heilt ein Spieler Mila vorher durch einen Zauber oder Trank, stoppt der Countdown sofort. Der Kristall reißt kontrolliert ein, ohne dass Mila in Lebensgefahr schwebt.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="300" width="560" x="1620" y="6530" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-3" edge="1" parent="1" source="O8MarJ5i8mJ102Qb0Z8C-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="U28gEqxTcT6NedzWE8BR-2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2420" y="3555" />
              <mxPoint x="2420" y="7240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-5" edge="1" parent="1" source="O8MarJ5i8mJ102Qb0Z8C-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3450" y="3510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-8" edge="1" parent="1" source="O8MarJ5i8mJ102Qb0Z8C-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2895" y="3800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-12" edge="1" parent="1" source="O8MarJ5i8mJ102Qb0Z8C-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="U28gEqxTcT6NedzWE8BR-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-14" edge="1" parent="1" source="O8MarJ5i8mJ102Qb0Z8C-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="U28gEqxTcT6NedzWE8BR-13">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2898" y="3850" />
              <mxPoint x="3710" y="3850" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="O8MarJ5i8mJ102Qb0Z8C-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;1&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;Der Zwischenstopp in den Ruinen&lt;/b&gt;&lt;br&gt;Der Spähtrupp hatte eigentlich gar nicht vor, diesen Ort genauer zu untersuchen. Sie befanden sich lediglich auf der Durchreise zu einer anderen, viel weiter entfernten Ausgrabungsstätte. Als das Wetter umschlug und die Temperaturen rapide fielen, suchten sie in den altbekannten, vermeintlich komplett leergeräumten Oberflächenruinen der Siedlung einen sicheren Unterschlupf.&lt;/p&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Das schmelzende Eis&lt;/b&gt;&lt;br&gt;Sie richteten sich tief im windgeschützten Kellergewölbe eines halbeingestürzten Gebäudes ein und entfachten ein kräftiges Lagerfeuer, um sich aufzuwärmen. Die anhaltende Hitze der Flammen ließ nach einigen Stunden eine massive Schicht aus uraltem Eis an der hinteren Kellerwand unbemerkt schmelzen.&lt;/p&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;0&quot;&gt;Der verborgene Mechanismus&lt;/b&gt;&lt;br&gt;Unter dem abtauenden Frost kam plötzlich ein intaktes, mechanisches Schaltpult aus der Aeor-Zeit zum Vorschein. Durch reines Glück und vorsichtiges Herumprobieren lösten die Späher den uralten Mechanismus aus. Mit einem tiefen, mahlenden Grollen glitt ein Teil der massiven Steinwand zur Seite und gab einen völlig unberührten, geheimen Zugangsschacht frei.&lt;/p&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Der strategische Rückzug&lt;/b&gt;&lt;br&gt;Ein kurzer Blick in die dunkle Tiefe reichte aus, um die Ausmaße eines gewaltigen Forschungskomplexes zu erahnen. Da die Späher genau um die tödlichen Gefahren – wie aktive Konstrukte, mutierte Bestien und magische Fallen – in solchen intakten Aeor-Laboren wussten, betraten sie den Schacht nicht. Sie versiegelten und tarnten den Mechanismus sofort wieder und eilten auf dem schnellsten Weg zurück, um den Außenposten zu alarmieren und eine große, gut ausgerüstete Expedition aufzustellen.&lt;/p&gt;" vertex="1">
          <mxGeometry height="470" width="555" x="2620" y="3320" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-1" parent="1" style="whiteSpace=wrap;html=1;" value="Erster Spätrupp" vertex="1">
          <mxGeometry height="60" width="120" x="2540" y="3250" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-2" parent="1" style="whiteSpace=wrap;html=1;" value="Splitter Kuppeln" vertex="1">
          <mxGeometry height="60" width="120" x="1830" y="7240" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-4" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;1&quot;&gt;Die verlassene Siedlung: &quot;Die Splitterkuppeln&quot;&lt;/h3&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;Die Siedlung hat bei den Plünderern und Abenteurern des Außenpostens den pragmatischen Spitznamen &lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;98&quot;&gt;&quot;Die Splitterkuppeln&quot;&lt;/b&gt; (oder oft einfach nur &quot;Splitter&quot;) erhalten.&lt;/p&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Grund:&lt;/b&gt; Aus der dicken Eisdecke ragen an dieser Stelle überall die zerbrochenen, scharfkantigen Reste alter, gläserner Aeor-Kuppeln heraus, die aus der Ferne wie riesige Eissplitter aussehen. Da hier jahrelang nur wertloser Schrott gefunden wurde, galt der Ort bis vor kurzem als absolutes Anfänger-Gebiet.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="180" width="560" x="1850" y="7320" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;5&quot;&gt;Das Späher-Duo (Die Veteranen)&lt;/h3&gt;&lt;p data-path-to-node=&quot;6&quot;&gt;Diese beiden bilden das ursprüngliche Entdecker-Team. Da sie extrem erfahren sind, arbeiten sie am liebsten nur zu zweit. Sie waren clever genug, das Schott nicht sofort zu öffnen, sondern Hilfe zu holen.&lt;/p&gt;&lt;p data-path-to-node=&quot;7&quot;&gt;&lt;b data-path-to-node=&quot;7&quot; data-index-in-node=&quot;0&quot;&gt;1. Varek (Der Überlebenskünstler)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;8&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Aussehen/Auftreten:&lt;/b&gt; Ein wettergegerbter, wortkarger Mensch (oder Halbelf) mit tiefen Kälteverbrennungen im Gesicht. Er trägt dicke, abgenutzte Pelze und bewegt sich völlig lautlos.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Seine Rolle:&lt;/b&gt; Varek ist der mit Abstand beste Spurenleser und Überlebensexperte des Außenpostens. Er kennt das unberechenbare Eis, die Wetterumschwünge und das Verhalten der Monster besser als jeder andere. Er hat den Mechanismus in der Höhle bemerkt, weil ihm Details auffallen, die andere übersehen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;&lt;b data-path-to-node=&quot;9&quot; data-index-in-node=&quot;0&quot;&gt;2. Zira (Die Mechanik-Veteranin)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;10&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,0,0&quot;&gt;&lt;b data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Aussehen/Auftreten:&lt;/b&gt; Eine pragmatische, raubeinige Zwergin (oder Tiefling), an deren Gürtel unzählige kleine Werkzeuge, Hämmerchen und magische Messgeräte klappern.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,0&quot;&gt;&lt;b data-path-to-node=&quot;10,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Ihre Rolle:&lt;/b&gt; Sie ist die Expertin für uralte Aeor-Technologie und Fallen. Während Anfänger blindlings Knöpfe drücken würden, weiß Zira genau, wann ein Mechanismus eine Geheimtür öffnet und wann er den gesamten Raum in Säure flutet. Sie war es, die den freigeschmolzenen Mechanismus in den Splitterkuppeln bedient und das Schott erfolgreich entriegelt hat.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="430" width="560" x="3500" y="3340" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-9" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(255, 255, 255); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Dem Ersten Spähtrupp haben sich nicht viele Erfaherene Abenteruer Angeschlossen viele Neulinge Weswegen Morgo Erst etwas besorgter war aber dern abenteuern nichts vorschreiben kann und Varek zumindes darum gebeten hatt ueber ein artefakt regelmaessige kommunikation aufrecht zu erhalten&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="560" x="1400" y="3945" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-15" edge="1" parent="1" source="U28gEqxTcT6NedzWE8BR-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="U28gEqxTcT6NedzWE8BR-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-10" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li&gt;&lt;p data-path-to-node=&quot;6,0,0&quot;&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Ping (Lebenszeichen):&lt;/b&gt; Wenn ein Benutzer zweimal mit dem Fingerknöchel auf seine Tafel klopft, vibriert die Partnertafel spürbar und die Ränder glimmen für einige Sekunden in einem sanften blauen Licht auf. Dieser einfache Ping verbraucht keine magische Energie und wird meist als simple &quot;Alles in Ordnung&quot;-Bestätigung genutzt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,1,0&quot;&gt;&lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Schriftliche Übertragung &amp;amp; Verfall:&lt;/b&gt; Schreibt man mit der Kreide eine Nachricht (maximal 25 Wörter), erscheint diese auf der Partnertafel. Das Senden einer komplexen Nachricht frisst jedoch die Magie der sendenden Tafel auf. Eine frisch gekoppelte Tafel kann exakt &lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;264&quot;&gt;10 Nachrichten&lt;/b&gt; versenden. Mit jeder gesendeten Nachricht wird der Schiefer spröder, bekommt feine Risse und verliert an Farbe.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,2,0&quot;&gt;&lt;b data-path-to-node=&quot;6,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Einseitige Zerstörung (Der Reset):&lt;/b&gt; Wird die 10. Nachricht gesendet, zerfällt ausschließlich die &lt;i data-path-to-node=&quot;6,2,0&quot; data-index-in-node=&quot;96&quot;&gt;sendende&lt;/i&gt; Tafel sofort zu feinem, grauen Staub. Die Empfängertafel bleibt völlig intakt. Um das Set wieder nutzbar zu machen, muss die intakte Tafel zurück zum Außenposten gebracht und dort in einem einstündigen Ritual mit einer neuen, leeren Schiefertafel magisch gekoppelt (resettet) werden.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,3,0&quot;&gt;&lt;b data-path-to-node=&quot;6,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Reichweite:&lt;/b&gt; Die Tafeln funktionieren zuverlässig über eine Distanz von bis zu 50 Meilen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,4,0&quot;&gt;&lt;b data-path-to-node=&quot;6,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Aeor-Störanfälligkeit (Schwäche):&lt;/b&gt; Das Artefakt nutzt oberflächliche Magie, die extrem störanfällig ist. Befindet sich der Sender in der Nähe von intakten Aeor-Relikten oder tief in den magisch verstrahlten Ruinen, bricht die Verbindung ein. Pings kommen stark verzögert oder als durchgehendes &quot;Stottern&quot; an. Geschriebene Nachrichten verschwimmen, Buchstaben fehlen völlig, oder die Sätze wandeln sich in sinnloses, magisches Gekritzel.&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="380" width="560" x="3010" y="2890" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-11" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;1&quot;&gt;Schiefer der Echorunen&lt;/h3&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;i data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Wundervoller Gegenstand (Gepaartes Artefakt), ungewöhnlich&lt;/i&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;Diese beiden unscheinbaren, handgroßen Tafeln bestehen aus dunklem Schiefer. An jeder Tafel ist ein kleines, weißes Stück Kreide an einem Lederband befestigt. Die Tafeln sind weder wertvoll noch sonderlich selten und werden im Außenposten oft für einfache Patrouillen genutzt, da sie leicht herzustellen, aber eben auch schnell verbraucht sind.&lt;/p&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;i data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Dem ersten Spähtrupp um Varek hatten sich bedauerlicherweise viele unerfahrene Neulinge angeschlossen. Morgo war darüber äußerst besorgt, doch da sie den freien Abenteurern keine direkten Vorschriften machen konnte, bat sie Varek inständig darum, zumindest über dieses Artefakt eine regelmäßige Kommunikation aufrechtzuerhalten.&lt;/i&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="560" x="2400" y="2880" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-13" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;5,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0&quot; data-index-in-node=&quot;0&quot;&gt;Nachricht 1&lt;/b&gt;&#xa;„Erster Tag. Neulinge sind langsam, aber diszipliniert. Wetter ist ruhig und klar. Varek.“&lt;/p&gt;&lt;p data-path-to-node=&quot;5,1&quot;&gt;&lt;b data-path-to-node=&quot;5,1&quot; data-index-in-node=&quot;0&quot;&gt;Nachricht 2&lt;/b&gt;&#xa;„Zweiter Tag. Keine besonderen Vorkommnisse. Kommen gut voran.“&lt;/p&gt;&lt;p data-path-to-node=&quot;5,2&quot;&gt;&lt;b data-path-to-node=&quot;5,2&quot; data-index-in-node=&quot;0&quot;&gt;Nachricht 3&lt;/b&gt;&#xa;„Dritter Tag. Die Eiswüste ist ruhig. Wir halten unser Tempo.“&lt;/p&gt;&lt;p data-path-to-node=&quot;5,3&quot;&gt;&lt;b data-path-to-node=&quot;5,3&quot; data-index-in-node=&quot;0&quot;&gt;Nachricht 4&lt;/b&gt;&#xa;„Sehen die Splitterkuppeln bereits am Horizont. Alles verläuft exakt nach Plan.“&lt;/p&gt;&lt;p data-path-to-node=&quot;5,4&quot;&gt;&lt;b data-path-to-node=&quot;5,4&quot; data-index-in-node=&quot;0&quot;&gt;Nachricht 5&lt;/b&gt;&#xa;„Erreichen die Siedlung in Kürze. Beginnen dann mit dem Aufbau des Lagers und der Durchsuchung der alten Keller. Varek Ende.“&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="560" x="3430" y="3890" as="geometry" />
        </mxCell>
        <mxCell id="U28gEqxTcT6NedzWE8BR-16" parent="1" style="text;whiteSpace=wrap;html=1;" value="Das Logbuch endet hier völlig unspektakulär. Varek und seine Gruppe kamen in den Splitterkuppeln an, richteten ihr Lager in einem Keller ein und fanden &lt;i data-path-to-node=&quot;7&quot; data-index-in-node=&quot;211&quot;&gt;danach&lt;/i&gt; durch reinen Zufall das verborgene Schott zum Labor." vertex="1">
          <mxGeometry height="70" width="560" x="3430" y="4145" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-3" edge="1" parent="1" source="TqPpJMBCEPTzOI8dIEuD-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="TqPpJMBCEPTzOI8dIEuD-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;blockquote data-path-to-node=&quot;4&quot;&gt;&lt;p data-path-to-node=&quot;4,0&quot;&gt;Euer Weg führt euch aus der offenen Eiswüste hinein in einen lichten, toten Wald. Die kargen, schwarzen Stämme der Nadelbäume stehen weit auseinander und biegen sich unter der dicken Schneelast, während sich am Horizont die massiven, schroffen Gipfel eines Gebirgszuges wie Zähne in den grauen Himmel bohren.&lt;/p&gt;&lt;p data-path-to-node=&quot;4,1&quot;&gt;Am Fuße dieser Berge, halb verborgen zwischen den Bäumen und meterdickem Eis, liegen die Ruinen. Die Gebäude wurden einst mit einer beängstigenden, unnachgiebigen Massivität errichtet – fensterlose Blöcke aus dunklem, glattem Stein und verbogenem Metall, die dem Zahn der Zeit und dem ewigen Frost getrotzt haben. Aus der schweren Eisdecke, die die gesamte Siedlung unter sich begräbt, ragen riesige, zerbrochene Überreste von Glaskuppeln empor. Sie fangen das fahle Licht ein und ragen wie gigantische, scharfe Eissplitter aus dem Boden. Ein kalter Wind pfeift heulend durch die hohlen Bauten dieses toten Ortes.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;5&quot;&gt;&lt;b data-path-to-node=&quot;5&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Notizen: Details zur Umgebung&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;6&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,0,0&quot;&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der lichte Wald:&lt;/b&gt; Die Bäume stehen nicht dicht genug, um sich davor zu verstecken, brechen aber den schlimmsten Wind ab. Der Schnee zwischen den Bäumen ist oft trügerisch – was aussieht wie eine harmlose Schneewehe, kann ein komplett zugeschneites Gebäude sein.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,1,0&quot;&gt;&lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Massive Aeor-Architektur:&lt;/b&gt; Die Gebäude sind keine normalen Holzhäuser, sondern bunkerartige Konstruktionen. Sie mussten einst gewaltige magische Kräfte und (vermutlich) den Absturz der Stadt überstehen. Die Wände sind enorm dick, fugenlos und haben weiche, abgerundete Kanten, an denen sich der Schnee auftürmt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,2,0&quot;&gt;&lt;b data-path-to-node=&quot;6,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Die namensgebenden Kuppeln:&lt;/b&gt; Ursprünglich waren diese Gebäude von magischen Glaskuppeln (vielleicht als Gewächshäuser oder Observatorien) gekrönt. Heute sind sie zersplittert. Die Ränder sind messerscharf. Wer unvorsichtig durch einen dieser oberen Zugänge klettert, kann sich schwere Schnittwunden zuziehen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,3,0&quot;&gt;&lt;b data-path-to-node=&quot;6,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Das Eis:&lt;/b&gt; Die Siedlung ist nicht einfach nur &quot;eingeschneit&quot;. Jahrhunderte des Tauens und Gefrierens haben die unteren Stockwerke und Straßen in eine massive, milchige Eisschicht eingeschlossen. Man spaziert hier oft auf der Höhe der ehemaligen ersten Stockwerke oder Dächer herum, weshalb die intakten Kellergeschosse so gut geschützt und verborgen blieben.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,4,0&quot;&gt;&lt;b data-path-to-node=&quot;6,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Akustik:&lt;/b&gt; Durch die vielen zersplitterten Kuppeln und die glatten Metallwände bricht sich der Wind in den Ruinen auf eine unheimliche, fast flötenartige Weise. Es ist extrem schwer auszumachen, aus welcher Richtung ein Geräusch (wie zum Beispiel das Knacken eines Astes oder ein Schritt im Schnee) wirklich kommt.&lt;/p&gt;&lt;/li&gt;&lt;div class=&quot;attachment-container unknown&quot;&gt;&lt;div class=&quot;interactive-content-block-span&quot;&gt;&lt;h2 data-test-id=&quot;interactive-content-block-header&quot; class=&quot;gds-headline-s&quot;&gt;&lt;/h2&gt;&lt;/div&gt;&lt;/div&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="620" width="560" x="1830" y="7490" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-10" edge="1" parent="1" source="TqPpJMBCEPTzOI8dIEuD-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="TqPpJMBCEPTzOI8dIEuD-9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2960" y="8130" />
              <mxPoint x="2210" y="8130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-12" edge="1" parent="1" source="TqPpJMBCEPTzOI8dIEuD-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="TqPpJMBCEPTzOI8dIEuD-11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2960" y="8130" />
              <mxPoint x="3280" y="8130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-15" edge="1" parent="1" source="TqPpJMBCEPTzOI8dIEuD-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="TqPpJMBCEPTzOI8dIEuD-14">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2960" y="8130" />
              <mxPoint x="4020" y="8130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;1. Der Waldrand (Die Ankunftszone)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; Hier lichtet sich der tote Nadelwald. Die ersten fensterlosen, dunklen Steinblöcke ragen wie Findlinge aus dem Schnee.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Mechanik/Gefahr:&lt;/b&gt; Der Schnee ist hier extrem tief. Zwischen den Bäumen und den ersten Gebäuden gibt es viele verdeckte Schneelöcher (alte Gräben oder Kellerfenster). Das ist der perfekte Ort für einen Engpass – hier könnte der massive Monster-Schwarm Milas Gruppe eingekesselt haben, als sie gerade ins Dorf fliehen wollten.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;6&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;2. Der Ring der Splitter (Das Gewächshaus-Viertel)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;&lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; Der äußere Ring der Siedlung. Hier reihen sich die Überreste massiver Gebäude aneinander, die alle von den namensgebenden, zersplitterten Glaskuppeln gekrönt sind. Einst waren dies vermutlich botanische Anlagen oder Observatorien.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;&lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Gefahr:&lt;/b&gt; Die zersprungenen Ränder der Kuppeln sind rasiermesserscharf. Wer hier hineinklettert oder hineinfällt, erleidet Schnittschaden. Der Wind pfeift durch die hohlen Kuppeln und macht akustische Wahrnehmung (Hören) fast unmöglich.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;8&quot;&gt;&lt;b data-path-to-node=&quot;8&quot; data-index-in-node=&quot;0&quot;&gt;3. Die versunkenen Straßen (Das Wohnviertel)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;9&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,0,0&quot;&gt;&lt;b data-path-to-node=&quot;9,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; Die massiven, fensterlosen Wohn- und Arbeitsblöcke der Aeor-Bürger. Die Spieler laufen hier wörtlich auf den flachen Dächern der Gebäude, da das Eis die Gassen dazwischen komplett aufgefüllt hat.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,1,0&quot;&gt;&lt;b data-path-to-node=&quot;9,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Erkundung:&lt;/b&gt; Um in die Gebäude zu gelangen, müssen die Spieler gefrorene Dachluken aufstemmen oder sich an einigen Stellen abseilen, wo das Eis in den alten Gassen tiefer eingesunken ist und den Blick auf alte, zugefrorene Türen freigibt. Im Inneren ist es pechschwarz und totenstill.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;10&quot;&gt;&lt;b data-path-to-node=&quot;10&quot; data-index-in-node=&quot;0&quot;&gt;4. Das Zentralgebäude (Die Administration)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;11&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,0,0&quot;&gt;&lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; In der Mitte der Siedlung thront ein besonders massiver, quadratischer Bunker. Er ist nicht von einer Kuppel gekrönt, sondern hat ein flaches, stark gepanzertes Dach. Hier liefen früher vermutlich die Energieleitungen und die Verwaltung der Siedlung zusammen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,1,0&quot;&gt;&lt;b data-path-to-node=&quot;11,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Bedeutung:&lt;/b&gt; Dieses Gebäude ist der Ankerpunkt der Ruine. Im tiefsten Untergeschoss dieses Bunkers hat Vareks Truppe damals ihr Lager aufgeschlagen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="600" width="560" x="2680" y="7480" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-4" parent="1" style="text;whiteSpace=wrap;" value="(Berge / Gebirgszug)&#xa;          /\      /\/\      /\      /\/\      /\&#xa;         /  \    /    \    /  \    /    \    /  \&#xa;=======================================================&#xa;&#xa;   *       *               *               *       *&#xa;       *       .-------.       .-------.       *&#xa;   *         .&#39;         &#39;.   .&#39;         &#39;.         *&#xa;           .&#39;  [Kuppel]  &#39;. .&#39;  [Kuppel]  &#39;.   *&#xa;    *      |      2       | |      2       |       *&#xa;           &#39;.           .&#39;   &#39;.           .&#39;&#xa;   *         &#39;.- - - -.&#39;       &#39;.- - - -.&#39;         *&#xa;       *          |                 |          *&#xa; .-------.        |      .---.      |        .-------.&#xa;.&#39;         &#39;.     |      | 3 |      |      .&#39;         &#39;.&#xa;|    2      |====(E)=====|===|=====(E)=====|    2      |&#xa;&#39;.         .&#39;     |      |___|      |      &#39;.         .&#39;&#xa; &#39;.- - - -&#39;       |                 |        &#39;.- - - -&#39;&#xa;       |     .---------.       .---------.     |&#xa;       |     |         |       |         |     |&#xa;       |     | Wohnblk |=======| Wohnblk |     |&#xa;       |     |    3    |       |    3    |     |&#xa;       |     &#39;---------&#39;       &#39;---------&#39;     |&#xa;       |          |                 |          |&#xa;       |          |   .---------.   |          |&#xa; .-------.        |   | Zentral |   |        .-------.&#xa;.&#39;         &#39;.     |   | Bunker  |   |      .&#39;         &#39;.&#xa;|    2      |====(E)==|    4    |==(E)=====|    2      |&#xa;&#39;.         .&#39;     |   | (Labor) |   |      &#39;.         .&#39;&#xa; &#39;.- - - -&#39;       |   &#39;---------&#39;   |        &#39;.- - - -&#39;&#xa;       *          |                 |          *&#xa;   *         .- - - - -.       .- - - - -.         *&#xa;           .&#39;           &#39;.   .&#39;           &#39;.   *&#xa;    *      |      2      |   |      2      |       *&#xa;           &#39;. [Kuppel]  .&#39;   &#39;. [Kuppel]  .&#39;&#xa;   *         &#39;.       .&#39;       &#39;.       .&#39;         *&#xa;       *       &#39;-----&#39;           &#39;-----&#39;       *&#xa;   *       *               *               *       *&#xa;          (Toter, verschneiter Nadelwald - Zone 1)" vertex="1">
          <mxGeometry height="770" width="590" x="3430" y="7270" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-5" edge="1" parent="1" source="TqPpJMBCEPTzOI8dIEuD-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.008;entryY=0.475;entryDx=0;entryDy=0;entryPerimeter=0;" target="TqPpJMBCEPTzOI8dIEuD-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;4&quot;&gt;Wer mutig genug ist, sich an den Rand eines zersplitterten Lochs zu stellen und in das Innere einer Kuppel hinabzusehen, blickt in einen sterilen, tiefgefrorenen Krater:&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der versteinerte Wald:&lt;/b&gt; Es gibt hier keine Blätter oder Ranken mehr. Was einst gewaltige Pflanzen waren, ist durch die schockartige Kälte beim Bruch der Kuppeln sofort abgestorben und im Laufe der Jahrhunderte versteinert oder komplett zu schwarzem, kohleartigem Staub zerfallen. Aus dem massiven Eisboden ragen nur noch versteinerte, schwarze Stümpfe und nackte, knöcherne Äste, die bei der kleinsten Berührung wie Glas zersplittern.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die gefrorene Magie:&lt;/b&gt; Die eigentliche Erde in diesen Laboren war stark magisch angereichert. Diese Erde ist nun zu einer steinharten, nachtblauen Eisschicht gefroren, aus der unnatürliche, scharfe Frostkristalle wachsen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Flackernde Aeor-Tech:&lt;/b&gt; Das Einzige, was hier unten nicht völlig tot ist, ist die uralte Architektur. Tief im Eis eingefroren, glimmen vereinzelt noch immer beschädigte UV- oder Wärmelampen in einem kränklichen, grellen Pink. Sie flackern im Rhythmus des heulenden Windes und werfen unheimliche, zuckende Schatten auf die versteinerten Pflanzenstümpfe.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;6&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;Die Gefahren im Detail (Angepasst):&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;&lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Das unzerstörbare Glas &amp;amp; Der Flöten-Wind:&lt;/b&gt; (Bleibt exakt gleich – die scharfen Kanten der Kuppel und der ohrenbetäubende Wind sind die Hauptgefahren, wenn man von außen in die Kuppeln späht).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;&lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die kristalline Erde (Neu):&lt;/b&gt; Wer in die Kuppel hinabsteigt und versucht, das Eis aufzubrechen, um den Grund zu untersuchen, riskiert eine magische Reaktion. Die gefrorenen Nährstoffe reagieren auf kinetische Energie – schlägt man zu hart darauf ein, können kleine, scharfe Eiskristalle wie Granatsplitter explodieren.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;8&quot;&gt;&lt;b data-path-to-node=&quot;8&quot; data-index-in-node=&quot;0&quot;&gt;Mögliche Funde (Realistischer Loot):&lt;/b&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;Es gibt keine lebenden Samen oder nützlichen Pflanzen mehr. Stattdessen finden sie Dinge, die unempfindlich gegen Kälte sind:&lt;/p&gt;&lt;ul data-path-to-node=&quot;10&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,0,0&quot;&gt;&lt;b data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Zerfallene Forschungsstationen:&lt;/b&gt; In den Randbereichen stehen verrostete Metallpulte mit versteinerten Aufzeichnungen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,0&quot;&gt;&lt;b data-path-to-node=&quot;10,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Kristallisiertes Mana (Statt Samen):&lt;/b&gt; Die Magie, die einst die Pflanzen nährte, hat sich am Grund der Kuppel in Form von rohen, rosenquarz-ähnlichen Kristallen abgesetzt. Sie sind extrem kalt und können im Außenposten für Alchemie verkauft werden, müssen aber vorsichtig transportiert werden.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="640" width="560" x="2180" y="8360" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-9" parent="1" style="whiteSpace=wrap;html=1;" value="2. Die Kuppel" vertex="1">
          <mxGeometry height="60" width="120" x="2150" y="8280" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-11" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;0&quot;&gt;3. Die versunkenen Straßen (Das Wohnviertel)&lt;/h3&gt;&lt;p data-path-to-node=&quot;1&quot;&gt;Dieser Bereich bildet den massiven Ring um den Zentral-Bunker. Die Architektur ändert sich hier drastisch: Statt fragiler Glaskuppeln stehen hier fensterlose, monolithische Blöcke aus dunklem Stein, die einst als Wohn- und Arbeitsquartiere der Aeor-Bürger dienten.&lt;/p&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Zum Vorlesen (Die Entdeckung des Schlittens):&lt;/b&gt;&lt;/p&gt;&lt;blockquote data-path-to-node=&quot;3&quot;&gt;&lt;p data-path-to-node=&quot;3,0&quot;&gt;Ihr lasst das unheimliche Pfeifen der zersplitterten Kuppeln hinter euch. Die Landschaft verändert sich. Die Gebäude hier sind flache, gigantische Steinblöcke, die so dicht aneinander stehen, dass das ewige Eis die Gassen dazwischen komplett aufgefüllt hat. Ihr lauft nicht auf dem Grund der Stadt, sondern direkt über die flachen Dächer dieser uralten Konstrukte.&lt;/p&gt;&lt;p data-path-to-node=&quot;3,1&quot;&gt;Plötzlich seht ihr etwas, das nicht in diese tote Welt aus Stein und Eis passt: Am Rand eines Daches, kurz vor einer tiefen Senke, steckt ein großer, moderner Transportschlitten im Schnee. Kisten und Werkzeuge liegen verstreut darum herum. Der Schnee ist hier aufgewühlt, als hätte ein wilder Kampf stattgefunden, und dunkle Flecken zeichnen sich auf dem weißen Untergrund ab.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;5&quot;&gt;&lt;b data-path-to-node=&quot;5&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Notizen: Die Umgebung und Mechanik&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;6&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,0,0&quot;&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Dächer-Pfad:&lt;/b&gt; Da das Eis die Schluchten zwischen den Gebäuden aufgefüllt hat, ist dies der einzige gangbare Weg. Die Dächer sind stellenweise extrem glatt. Wer im Kampf weite Strecken rennt (Dash), riskiert auf dem Eis auszurutschen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,1,0&quot;&gt;&lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Eisspalten (Eingesunkene Straßen):&lt;/b&gt; An einigen Stellen zwischen den Gebäuden ist das Eis trichterförmig in die Tiefe gebrochen und gibt den Blick auf alte, zugefrorene Eingangstüren weit unten frei.&lt;/p&gt;&lt;ul data-path-to-node=&quot;6,1,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,1,1,0,0&quot;&gt;&lt;i data-path-to-node=&quot;6,1,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Gefahr:&lt;/i&gt; Diese Spalten sind rutschig. Wer unvorsichtig am Rand kämpft oder ungesichert hinabklettern will, kann abrutschen und in die Dunkelheit der alten Gassen fallen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;8&quot;&gt;&lt;b data-path-to-node=&quot;8&quot; data-index-in-node=&quot;0&quot;&gt;Die Spuren der Tragödie (Der Schlitten)&lt;/b&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;Dies ist der Ort, an dem die zweite Expedition (Mila, Bari, Orvo) von den Monstern aus dem Labor überrascht wurde, als sie gerade ihr Lager aufschlagen oder Ausrüstung abladen wollten.&lt;/p&gt;&lt;p data-path-to-node=&quot;10&quot;&gt;Wenn die Spieler den Bereich untersuchen (Wahrnehmung oder Überleben), finden sie folgende Hinweise:&lt;/p&gt;&lt;ul data-path-to-node=&quot;11&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,0,0&quot;&gt;&lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Schlitten:&lt;/b&gt; Die Zugtiere fehlen. Die Zugseile sind nicht gerissen, sondern wurden hastig mit einer Klinge durchtrennt (vermutlich, um die Tiere als Ablenkung freizulassen oder weil sie in Panik gerieten).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,1,0&quot;&gt;&lt;b data-path-to-node=&quot;11,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Ausrüstung:&lt;/b&gt; Auf dem Schlitten liegen schwere Brecheisen, dicke Seile und leere Transportkisten – alles, was man braucht, um ein altes Labor systematisch zu plündern.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,2,0&quot;&gt;&lt;b data-path-to-node=&quot;11,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Zweierlei Blut:&lt;/b&gt; Im aufgewühlten Schnee finden sich rote Blutspritzer (von Milas Gruppe) und eine zähe, dunkelviolette Flüssigkeit, die fast dampft und kleine Löcher in das Eis geätzt hat (das Blut der mutierten Labor-Monster).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,3,0&quot;&gt;&lt;b data-path-to-node=&quot;11,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Zwei Fluchtwege:&lt;/b&gt; Die Fußspuren erzählen eine klare Geschichte. Eine einzelne Person (Mila) ist in Panik rückwärts geflohen und hat eine Spur in Richtung des lichten Waldes (Zone 1) hinterlassen. Die Spuren von zwei weiteren Personen (Bari und Orvo) führen tief in die Siedlung hinein, direkt über die Dächer auf den massiven Zentral-Bunker (Zone 4) zu.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="850" width="560" x="3000" y="8350" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-13" parent="1" style="whiteSpace=wrap;html=1;" value="3. Versunken strassen" vertex="1">
          <mxGeometry height="60" width="120" x="2930" y="8290" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-14" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;3&quot;&gt;4. Der Zentral-Bunker (Der Schlund in die Tiefe)&lt;/h3&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;Dieser massive, monolithische Bau bildet das geographische Zentrum der Splitterkuppeln. Es gibt hier keine offensichtlichen Kampfspuren an der Oberfläche – nur die drückende Stille der Ruinen und den dunklen Eingang, der wie ein aufgerissener Schlund in die Tiefe führt.&lt;/p&gt;&lt;p data-path-to-node=&quot;5&quot;&gt;&lt;b data-path-to-node=&quot;5&quot; data-index-in-node=&quot;0&quot;&gt;Zum Vorlesen (Die Ankunft am Bunker):&lt;/b&gt;&lt;/p&gt;&lt;blockquote data-path-to-node=&quot;6&quot;&gt;&lt;p data-path-to-node=&quot;6,0&quot;&gt;Ihr folgt den Spuren über die vereisten Dächer, bis ihr das massivste Gebäude der Siedlung erreicht. Der Zentral-Bunker ist ein gigantischer, quadratischer Block aus pechschwarzem Stein. Die schweren, metallenen Doppeltüren am Haupteingang stehen weit offen – ein dunkles, einladendes Viereck im weißen Schnee.&lt;/p&gt;&lt;p data-path-to-node=&quot;6,1&quot;&gt;Hier draußen gibt es keinen Kampfeslärm, keine Zerstörung. Alles wirkt totenstill und friedlich. Doch der Schnee am Eingang erzählt eine andere Geschichte: Ihr seht ordentliche, ruhige Fußspuren, die in das dunkle Gebäude hineinführen. Und ihr seht chaotische, weit auseinanderliegende Spuren, die in Panik wieder herausstürmen – begleitet von ersten, dunkelroten Blutstropfen im weißen Schnee.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;8&quot;&gt;&lt;b data-path-to-node=&quot;8&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Notizen: Das Innere des Foyers&lt;/b&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;Wenn die Spieler das dunkle, eiskalte Foyer des Bunkers betreten, finden sie keine Barrikade, sondern nur die beklemmende Dunkelheit einer uralten Ruine.&lt;/p&gt;&lt;ul data-path-to-node=&quot;10&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,0,0&quot;&gt;&lt;b data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Abgrund (Der Weg in die Höhle):&lt;/b&gt; In der Mitte des gewaltigen Empfangsraumes ist der Boden vor Jahrhunderten eingebrochen. Wo früher Treppenhäuser oder Aufzüge waren, gähnt nun ein tiefer, natürlicher aussehender Schacht in den Fels und das Eis hinab – das ist der Weg in das tiefe Kellergewölbe (die Höhle), in der Varek das Schott gefunden hat.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,0&quot;&gt;&lt;b data-path-to-node=&quot;10,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Seile:&lt;/b&gt; An einer der massiven Steinsäulen neben dem Abgrund sind dicke, professionelle Kletterseile befestigt, die in die tintenschwarze Tiefe der Höhle hinabhängen. Milas Gruppe hat sich hier routiniert abgeseilt.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;&lt;b data-path-to-node=&quot;10,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Blut an den Seilen:&lt;/b&gt; Eines der Seile ist auf halber Höhe mit Blut verschmiert. Jemand ist hier in absoluter Todesangst nach oben geklettert.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;12&quot;&gt;&lt;b data-path-to-node=&quot;12&quot; data-index-in-node=&quot;0&quot;&gt;Die magische Warnung (Der Ring der Echorunen)&lt;/b&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;13&quot;&gt;Falls die Spieler den Ring dabei haben:&#xa;Sobald sie sich dem Abgrund in der Mitte des Foyers nähern, beginnt der Ring an der Hand unangenehm heiß zu werden. Er vibriert hektisch und unregelmäßig. Die massive, wilde Magie aus dem geöffneten Labor tief unter ihnen steigt durch den Schacht nach oben auf und stört das Artefakt komplett. Es wird klar: Was auch immer dort unten passiert ist, es hat mit der uralten Magie von Aeor zu tun.&lt;/p&gt;" vertex="1">
          <mxGeometry height="680" width="560" x="3740" y="8380" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-16" parent="1" style="whiteSpace=wrap;html=1;" value="4. Bunker" vertex="1">
          <mxGeometry height="60" width="120" x="3670" y="8290" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-21" edge="1" parent="1" source="TqPpJMBCEPTzOI8dIEuD-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="5380" y="8470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-17" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;blockquote data-path-to-node=&quot;6&quot;&gt;&lt;p data-path-to-node=&quot;6,0&quot;&gt;Ihr lasst die massiven Steindächer der Ruinen hinter euch und folgt den chaotischen Spuren zurück in den lichten, schwarzen Nadelwald. Der Schnee erzählt hier die Geschichte einer reinen, panischen Flucht. Ihr seht tief eingedrückte Stiefelabdrücke von Leuten, die gerannt, gestrauchelt und wieder auf die Beine gezogen wurden.&lt;/p&gt;&lt;p data-path-to-node=&quot;6,1&quot;&gt;Je tiefer ihr zwischen die toten Bäume dingt, desto mehr rote Blutspritzer verteilen sich im Schnee. Abgebrochene Äste und tiefe Kratzspuren an den Stämmen zeugen von einem erbitterten, aber aussichtslosen Kampf. Schließlich, in einer Senke zwischen zwei massiven Baumwurzeln, endet die Spur. Dort im Schnee liegen die zerrissenen, halb gefrorenen Überreste von zwei humanoiden Körpern.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;8&quot;&gt;&lt;b data-path-to-node=&quot;8&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Notizen: Die Untersuchung der Leichen&lt;/b&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;9&quot;&gt;Wenn die Spieler näher herantreten und die Szenerie untersuchen (Wurf auf &lt;i data-path-to-node=&quot;9&quot; data-index-in-node=&quot;74&quot;&gt;Medizin&lt;/i&gt; oder &lt;i data-path-to-node=&quot;9&quot; data-index-in-node=&quot;87&quot;&gt;Überleben&lt;/i&gt;), können sie folgende grausige Details ans Licht bringen:&lt;/p&gt;&lt;ul data-path-to-node=&quot;10&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,0,0&quot;&gt;&lt;b data-path-to-node=&quot;10,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Identifikation:&lt;/b&gt; Anhand ihrer Kleidung und Rüstung sind die beiden eindeutig als Bari und Orvo von der zweiten Expedition zu erkennen. Ihre Waffen liegen achtlos im Schnee verstreut – einige Klingen sind abgebrochen, als hätten sie auf etwas Unnachgiebiges eingeschlagen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,0&quot;&gt;&lt;b data-path-to-node=&quot;10,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Todesursache (Die Bisswunden):&lt;/b&gt; Die Leichen wurden nicht einfach durch Waffen getötet. Sie sind übersät mit massiven, brutalen Bissspuren.&lt;/p&gt;&lt;ul data-path-to-node=&quot;10,1,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,1,1,0,0&quot;&gt;&lt;i data-path-to-node=&quot;10,1,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Detail:&lt;/i&gt; Wer sich die Wunden genauer ansieht, erkennt, dass dies keine normalen Wolfs- oder Bärenbisse sind. Die Kieferabdrücke sind unnatürlich groß, und die Wundränder sehen aus, als hätte der Speichel der Bestien die Haut und Rüstung leicht verätzt. Etwas Mutiertes und Ausgehungertes hat sie hier in Stücke gerissen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;&lt;b data-path-to-node=&quot;10,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Spuren der Bestien:&lt;/b&gt; Um die Leichen herum finden sich die Fußspuren der Angreifer. Es sind keine normalen Tierpfoten, sondern fremdartige, schwere Abdrücke mit unnatürlich langen Krallen, die nach dem Gemetzel direkt wieder zurück in Richtung des Zentral-Bunkers (Zone 4) führen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;12&quot;&gt;&lt;b data-path-to-node=&quot;12&quot; data-index-in-node=&quot;0&quot;&gt;Der Ring der Echorunen (Der Beweis)&lt;/b&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;13&quot;&gt;Hier ist der perfekte Ort, um den Kommunikationsabbruch endgültig zu erklären.&#xa;Wenn die Spieler die Leichen durchsuchen, finden sie an der blutigen, erfrorenen Hand von Bari (oder Orvo) den &lt;b data-path-to-node=&quot;13&quot; data-index-in-node=&quot;190&quot;&gt;zweiten Ring der Echorunen&lt;/b&gt;.&lt;/p&gt;&lt;ul data-path-to-node=&quot;14&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,0,0&quot;&gt;Das Metall des Ringes ist stumpf und hat einen feinen Riss.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,1,0&quot;&gt;Da der Träger massiven Schaden erlitten hat und verstorben ist, ist die magische Bindung des gepaarten Artefakts zerrissen. Das erklärt, warum Mila (oder der Außenposten) plötzlich nur noch ein unregelmäßiges Stottern oder gar nichts mehr empfangen hat. Das Artefakt ist tot – genau wie seine Besitzer.&lt;/p&gt;&lt;/li&gt;&lt;div class=&quot;attachment-container unknown&quot;&gt;&lt;div class=&quot;interactive-content-block-span&quot;&gt;&lt;h2 data-test-id=&quot;interactive-content-block-header&quot; class=&quot;gds-headline-s&quot;&gt;&lt;/h2&gt;&lt;/div&gt;&lt;/div&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="700" width="560" x="4640" y="8380" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-18" parent="1" style="whiteSpace=wrap;html=1;" value="1. Wald Rand (orvo Mustav)" vertex="1">
          <mxGeometry height="60" width="120" x="4500" y="8280" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-19" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;blockquote data-path-to-node=&quot;5&quot;&gt;&lt;p data-path-to-node=&quot;5,0&quot;&gt;Euer Weg führt euch aus der endlosen, weißen Weite der Eiswüste hinein in ein spärliches, totes Wäldchen. Die schwarzen, rissigen Stämme der Nadelbäume stehen weit auseinander, als hätten sie selbst in der Kälte den Kontakt zueinander verloren. Ihre kahlen, knöchernen Äste biegen sich ächzend unter der meterdicken Schneelast.&lt;/p&gt;&lt;p data-path-to-node=&quot;5,1&quot;&gt;Der Schnee vor euch liegt unberührt und trügerisch hoch. Der eisige Wind verfängt sich in den toten Baumkronen und erzeugt ein unheimliches, leises Zischen, doch ansonsten herrscht hier eine absolute, sterile Totenstille – kein Vogelschrei, kein Knacken im Unterholz. Durch das dunkle Astwerk könnt ihr in der Ferne bereits die massiven, schroffen Umrisse der Ruinen erkennen, die halb vom Eis verschluckt am Fuß der dunklen Berge liegen.&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-path-to-node=&quot;7&quot;&gt;&lt;b data-path-to-node=&quot;7&quot; data-index-in-node=&quot;0&quot;&gt;Spielleiter-Notizen: Atmosphäre und Mechanik&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;8&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Die trügerische Stille:&lt;/b&gt; Betone die absolute Abwesenheit von Leben. Es gibt hier keine normalen Tiere. Kein Eichhörnchen, keine Wölfe, keine Vögel. Die natürliche Fauna meidet diesen Ort instinktiv, was bei Druiden oder Waldläufern in der Gruppe ein starkes Gefühl des Unbehagens auslösen sollte.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Schwieriges Gelände:&lt;/b&gt; Der Wald wirkt offen, aber der Boden ist heimtückisch. Der Schnee hat sich hier über Jahrhunderte in Schichten abgelagert. Zwischen den Bäumen verbergen sich tiefe Schneelöcher und alte, überfrorene Gräben.&lt;/p&gt;&lt;ul data-path-to-node=&quot;8,1,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,1,0,0&quot;&gt;&lt;i data-path-to-node=&quot;8,1,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Mechanik:&lt;/i&gt; Der gesamte Wald gilt als &lt;i data-path-to-node=&quot;8,1,1,0,0&quot; data-index-in-node=&quot;36&quot;&gt;schwieriges Gelände&lt;/i&gt; (halbe Bewegungsrate), es sei denn, die Spieler haben Schneeschuhe oder nutzen Magie. Wer blindlings losrennt, muss einen Geschicklichkeits-Rettungswurf bestehen, um nicht hüfttief in eine Schneewehe einzubrechen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,2,0&quot;&gt;&lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Sichtlinien:&lt;/b&gt; Obwohl die Bäume weit auseinander stehen, brechen die dicken, verschneiten Stämme die Sicht auf weite Distanz auf. Man kann die massiven Silhouetten der fernen Gebäude (die Wohnblöcke und Kuppeln) sehen, aber Details am Boden verschwinden schnell im Weiß.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,3,0&quot;&gt;&lt;span class=&quot;interactive-content-link-span high-prominence ng-star-inserted&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="530" width="560" x="1450" y="8380" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-20" parent="1" style="whiteSpace=wrap;html=1;" value="1 Wald eingan" vertex="1">
          <mxGeometry height="60" width="120" x="1400" y="8300" as="geometry" />
        </mxCell>
        <mxCell id="TqPpJMBCEPTzOI8dIEuD-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Ueberfall von&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;2 Winter Wolf&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;2 - 4&amp;nbsp; Dire Wolfs&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="200" x="5390" y="8460" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
