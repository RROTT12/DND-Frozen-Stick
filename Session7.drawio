              <mxPoint x="2340" y="1540" />
              <mxPoint x="2660" y="1540" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="_VzEKOpUxhcdtZb5pjBz-7" edge="1" parent="1" source="_VzEKOpUxhcdtZb5pjBz-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="_VzEKOpUxhcdtZb5pjBz-21">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2340" y="1540" />
              <mxPoint x="3980" y="1540" />
              <mxPoint x="3980" y="1810" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="_VzEKOpUxhcdtZb5pjBz-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;1. Der Waldrand (Die Ankunftszone)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; Hier lichtet sich der tote Nadelwald. Die ersten fensterlosen, dunklen Steinblöcke ragen wie Findlinge aus dem Schnee.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Mechanik/Gefahr:&lt;/b&gt; Der Schnee ist hier extrem tief. Zwischen den Bäumen und den ersten Gebäuden gibt es viele verdeckte Schneelöcher (alte Gräben oder Kellerfenster). Das ist der perfekte Ort für einen Engpass – hier könnte der massive Monster-Schwarm Milas Gruppe eingekesselt haben, als sie gerade ins Dorf fliehen wollten.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;6&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;2. Der Ring der Splitter (Das Gewächshaus-Viertel)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;&lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; Der äußere Ring der Siedlung. Hier reihen sich die Überreste massiver Gebäude aneinander, die alle von den namensgebenden, zersplitterten Glaskuppeln gekrönt sind. Einst waren dies vermutlich botanische Anlagen oder Observatorien.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;&lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Gefahr:&lt;/b&gt; Die zersprungenen Ränder der Kuppeln sind rasiermesserscharf. Wer hier hineinklettert oder hineinfällt, erleidet Schnittschaden. Der Wind pfeift durch die hohlen Kuppeln und macht akustische Wahrnehmung (Hören) fast unmöglich.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;8&quot;&gt;&lt;b data-path-to-node=&quot;8&quot; data-index-in-node=&quot;0&quot;&gt;3. Die versunkenen Straßen (Das Wohnviertel)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;9&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,0,0&quot;&gt;&lt;b data-path-to-node=&quot;9,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; Die massiven, fensterlosen Wohn- und Arbeitsblöcke der Aeor-Bürger. Die Spieler laufen hier wörtlich auf den flachen Dächern der Gebäude, da das Eis die Gassen dazwischen komplett aufgefüllt hat.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,1,0&quot;&gt;&lt;b data-path-to-node=&quot;9,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Erkundung:&lt;/b&gt; Um in die Gebäude zu gelangen, müssen die Spieler gefrorene Dachluken aufstemmen oder sich an einigen Stellen abseilen, wo das Eis in den alten Gassen tiefer eingesunken ist und den Blick auf alte, zugefrorene Türen freigibt. Im Inneren ist es pechschwarz und totenstill.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-path-to-node=&quot;10&quot;&gt;&lt;b data-path-to-node=&quot;10&quot; data-index-in-node=&quot;0&quot;&gt;4. Das Zentralgebäude (Die Administration)&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;11&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,0,0&quot;&gt;&lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Beschreibung:&lt;/b&gt; In der Mitte der Siedlung thront ein besonders massiver, quadratischer Bunker. Er ist nicht von einer Kuppel gekrönt, sondern hat ein flaches, stark gepanzertes Dach. Hier liefen früher vermutlich die Energieleitungen und die Verwaltung der Siedlung zusammen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;11,1,0&quot;&gt;&lt;b data-path-to-node=&quot;11,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Bedeutung:&lt;/b&gt; Dieses Gebäude ist der Ankerpunkt der Ruine. Im tiefsten Untergeschoss dieses Bunkers hat Vareks Truppe damals ihr Lager aufgeschlagen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="600" width="560" x="2060" y="890" as="geometry" />
        </mxCell>
        <mxCell id="_VzEKOpUxhcdtZb5pjBz-9" parent="1" style="text;whiteSpace=wrap;" value="(Berge / Gebirgszug)&#xa;          /\      /\/\      /\      /\/\      /\&#xa;         /  \    /    \    /  \    /    \    /  \&#xa;=======================================================&#xa;&#xa;   *       *               *               *       *&#xa;       *       .-------.       .-------.       *&#xa;   *         .&#39;         &#39;.   .&#39;         &#39;.         *&#xa;           .&#39;  [Kuppel]  &#39;. .&#39;  [Kuppel]  &#39;.   *&#xa;    *      |      2       | |      2       |       *&#xa;           &#39;.           .&#39;   &#39;.           .&#39;&#xa;   *         &#39;.- - - -.&#39;       &#39;.- - - -.&#39;         *&#xa;       *          |                 |          *&#xa; .-------.        |      .---.      |        .-------.&#xa;.&#39;         &#39;.     |      | 3 |      |      .&#39;         &#39;.&#xa;|    2      |====(E)=====|===|=====(E)=====|    2      |&#xa;&#39;.         .&#39;     |      |___|      |      &#39;.         .&#39;&#xa; &#39;.- - - -&#39;       |                 |        &#39;.- - - -&#39;&#xa;       |     .---------.       .---------.     |&#xa;       |     |         |       |         |     |&#xa;       |     | Wohnblk |=======| Wohnblk |     |&#xa;       |     |    3    |       |    3    |     |&#xa;       |     &#39;---------&#39;       &#39;---------&#39;     |&#xa;       |          |                 |          |&#xa;       |          |   .---------.   |          |&#xa; .-------.        |   | Zentral |   |        .-------.&#xa;.&#39;         &#39;.     |   | Bunker  |   |      .&#39;         &#39;.&#xa;|    2      |====(E)==|    4    |==(E)=====|    2      |&#xa;&#39;.         .&#39;     |   | (Labor) |   |      &#39;.         .&#39;&#xa; &#39;.- - - -&#39;       |   &#39;---------&#39;   |        &#39;.- - - -&#39;&#xa;       *          |                 |          *&#xa;   *         .- - - - -.       .- - - - -.         *&#xa;           .&#39;           &#39;.   .&#39;           &#39;.   *&#xa;    *      |      2      |   |      2      |       *&#xa;           &#39;. [Kuppel]  .&#39;   &#39;. [Kuppel]  .&#39;&#xa;   *         &#39;.       .&#39;       &#39;.       .&#39;         *&#xa;       *       &#39;-----&#39;           &#39;-----&#39;       *&#xa;   *       *               *               *       *&#xa;          (Toter, verschneiter Nadelwald - Zone 1)" vertex="1">
          <mxGeometry height="770" width="590" x="2810" y="680" as="geometry" />
        </mxCell>
        <mxCell id="_VzEKOpUxhcdtZb5pjBz-10" edge="1" parent="1" source="_VzEKOpUxhcdtZb5pjBz-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.008;entryY=0.475;entryDx=0;entryDy=0;entryPerimeter=0;" target="_VzEKOpUxhcdtZb5pjBz-9">
