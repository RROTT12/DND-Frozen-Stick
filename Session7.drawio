        <mxCell id="_VzEKOpUxhcdtZb5pjBz-110" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 20px; color: rgb(204, 0, 0);&quot;&gt;NO DORE HERE&lt;/font&gt;" vertex="1">
