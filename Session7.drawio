        <mxCell id="_VzEKOpUxhcdtZb5pjBz-111" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;6,5&lt;/font&gt;&lt;/span&gt;" vertex="1">
