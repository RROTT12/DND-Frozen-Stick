            <Array as="points">
              <mxPoint x="2340" y="1540" />
              <mxPoint x="1590" y="1540" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="_VzEKOpUxhcdtZb5pjBz-6" edge="1" parent="1" source="_VzEKOpUxhcdtZb5pjBz-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="_VzEKOpUxhcdtZb5pjBz-18">
          <mxGeometry relative="1" as="geometry">
