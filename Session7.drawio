        </mxCell>
        <mxCell id="_VzEKOpUxhcdtZb5pjBz-112" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Das Sortier-Lager:&lt;/b&gt; Tische, auf denen Söldner geplünderte Hightech-Beute in Kisten sortieren (Kategorien wie &quot;Waffen&quot;, &quot;Energie&quot;, &quot;Ausschuss&quot;)." vertex="1">
          <mxGeometry height="50" width="560" x="12120" y="6820" as="geometry" />
        </mxCell>
        <mxCell id="_VzEKOpUxhcdtZb5pjBz-113" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;2,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Klingen-Galerie:&lt;/b&gt;" vertex="1">
