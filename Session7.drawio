        <mxCell id="_VzEKOpUxhcdtZb5pjBz-86" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: rgb(0, 0, 0); font-size: 20px;&quot;&gt;18&lt;/font&gt;" vertex="1">
