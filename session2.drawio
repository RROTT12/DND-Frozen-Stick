            <mxGeometry height="310" width="560" x="2680" y="15650" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-67" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-content-chunk-id=&quot;b2acce79-2060-4743-aa87-f510b5f80b7a&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;If the characters don’t earn Ferol’s trust, the wight attacks, fighting until destroyed.&lt;/p&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="-15" y="16480" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;The undead&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744310-ferol-sal&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744310-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;Ferol Sal&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;has worked tirelessly in the laboratory for centuries, obsessed with crafting a disease that can kill the gods. Despite having made no progress in all that time, he keeps working. Ferol is a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17059-wight&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17059-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;wight&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;with an Intelligence of 16 (+3).&lt;/span&gt;" link="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;The undead&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744310-ferol-sal&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744310-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;Ferol Sal&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;has worked tirelessly in the laboratory for centuries, obsessed with crafting a disease that can kill the gods. Despite having made no progress in all that time, he keeps working. Ferol is a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17059-wight&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17059-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;wight&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;with an Intelligence of 16 (+3).&lt;/span&gt;" id="n4fE8acd2FAlWuIs1wk2-68">
