y: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;Wetzstein&lt;/b&gt; &amp;amp; ein wasserdichter Zunderwimpel.&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 1px solid; inset: auto; clear: none; clip: auto; color: rgb(212, 209, 203); columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: table-cell; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(212, 209, 203) none 0px; overlay: none; padding: 8px 12px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;&lt;span data-path-to-node=&quot;2,8,2,0&quot; style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 0px none rgb(212, 209, 203); inset: auto; clear: none; clip: auto; color: rgb(212, 209, 203); columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: inline; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(212, 209, 203) none 0px; overlay: none; padding: 0px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;Wartung für die eigene Ausrüstung.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="490" width="560" x="920" y="6120" as="geometry" />
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-53" edge="1" parent="1" source="LJnpm5BnixMahp6EwiEF-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="LJnpm5BnixMahp6EwiEF-52">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="5535" />
              <mxPoint x="800" y="5870" />
              <mxPoint x="1200" y="5870" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-54" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;1&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;Das Gruppensymbol: „Die Frost-Narbe“ (The Frost Scar)&lt;/b&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;Diese Gruppe besteht oft aus Deserteuren, gescheiterten Schatzsuchern oder Ausgestoßenen der Außenposten.&lt;/p&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Das Symbol:&lt;/b&gt; Ein &lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;16&quot;&gt;stilisierter, blutroter Handabdruck&lt;/b&gt;, bei dem der Daumen fehlt, gemalt auf weißes Robbenleder oder direkt auf die Segel ihrer Boote.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Bedeutung:&lt;/b&gt; Es steht für den „Opferpreis“ des Eises – wer in Eiselcross überleben will, muss Teile von sich zurücklassen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Erkennungsmerkmal:&lt;/b&gt; Viele Mitglieder haben sich absichtlich eine Narbe über die Wange oder das Auge zugefügt, die wie ein Riss im Eis aussieht.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="230" width="560" x="200" y="5700" as="geometry" />
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-55" edge="1" parent="1" source="LJnpm5BnixMahp6EwiEF-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="LJnpm5BnixMahp6EwiEF-54">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="5815" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-56" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Die Pfoten des Schneeleoparden&lt;/b&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;i data-path-to-node=&quot;3&quot; data-index-in-node=&quot;0&quot;&gt;(Wundersamer Gegenstand, selten)&lt;/i&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;4&quot;&gt;Diese Stiefel sind aus dem dichten, silberweißen Fell eines Schneeleoparden gefertigt und die Sohlen sind mit einer Schicht aus magisch gehärtetem blauen Eis überzogen.&lt;/p&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Effekt:&lt;/b&gt; Einmal pro Tag kannst du die Magie der Stiefel aktivieren, um den Zauber &lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;85&quot;&gt;Schritt durch den Nebel (Misty Step)&lt;/b&gt; zu wirken (als Bonusaktion).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der visuelle Effekt:&lt;/b&gt; Anstatt dich in bloßem Nebel aufzulösen, wirbelst du in einem kleinen &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;91&quot;&gt;Schneegestöber&lt;/b&gt; auf und erscheinst am Zielort, während für einen Moment die Luft um dich herum gefriert.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Haken (Flavor):&lt;/b&gt; Die Stiefel fühlen sich immer eiskalt an. Wenn man sie trägt, hinterlässt man keine normalen Fußspuren, sondern kleine Frostblumen auf dem Boden.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="270" width="560" x="200" y="6040" as="geometry" />
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-57" parent="1" style="whiteSpace=wrap;html=1;" value="Capitain Loot" vertex="1">
          <mxGeometry height="70" width="120" x="120" y="5970" as="geometry" />
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-59" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;2,0&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;„Der endlose Nebel des Eismeers reißt plötzlich auf. Vor euch ragt die gewaltige, weißgepeitschte Küste von &lt;b data-path-to-node=&quot;2,0&quot; data-index-in-node=&quot;108&quot; style=&quot;&quot;&gt;Forenn&lt;/b&gt; aus dem dunklen Wasser. Es ist kein einladendes Land – es ist eine Welt aus ewigem Eis und schroffen Klippen.&lt;/font&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;2,1&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;In einer geschützten Bucht erkennt ihr die ersten Anzeichen von Zivilisation: Ein paar robuste Holzhütten und Zelte, die sich eng an die Felsen schmiegen, und ein kleiner Steg, der dem eisigen Wellengang trotzt. Über dem Außenposten weht die Flagge von Uthodurn. Ihr habt &lt;b data-path-to-node=&quot;2,1&quot; data-index-in-node=&quot;272&quot; style=&quot;&quot;&gt;Syrinlya&lt;/b&gt; erreicht. Die Kälte hier ist so beißend, dass jeder Atemzug wie Glas in der Lunge brennt – doch irgendwo dort oben, in den Ruinen im Eis, liegt die einzige Hoffnung für Palebank.“&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="560" x="90" y="6490" as="geometry" />
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-60" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;5,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Ankunft&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;5,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;„Die Temperatur ist stetig gefallen, seit ihr Palebank verlassen habt, doch es scheint noch kälter zu werden, als ihr die Rampe der &lt;i data-path-to-node=&quot;5,0&quot; data-index-in-node=&quot;132&quot;&gt;Remorhaz&lt;/i&gt; hinunter auf den gefrorenen Boden von Forenn tretet. Durch den peitschenden Schnee erkennt ihr Pelz-Zelte und Jurten, die in einem großen Lager angeordnet sind. Lagerfeuer werden vom Wind hin- und hergerissen, während Zwerge und Elfen sich dicht an die Flammen kauern.&lt;/font&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;5,1&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;‚Keine Sorge! Irgendwann kühlt es hier sicher noch ab!‘, brüllt eine scherzende Stimme über den Schnee hinweg. Eine Zwergin mit einer struppigen Mähne aus ungepfleg&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tem Haar verbeugt sich tief vor euch. ‚&lt;/span&gt;&lt;b data-path-to-node=&quot;5,1&quot; data-index-in-node=&quot;203&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Morgo Delwur&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, zu euren Diensten. Willkommen in Eiselcross!‘“&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="560" x="60" y="7100" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-7" edge="1" parent="1" source="LJnpm5BnixMahp6EwiEF-61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="_KPzVuf8w2iddTT2j93n-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="LJnpm5BnixMahp6EwiEF-61" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h2 id=&quot;Syrinlya&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;774b88a8-f970-4553-9467-e8c35c068591&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 19.5px 0px 6.5px; font-family: Roboto, Helvetica, sans-serif; font-size: 26px; font-weight: 400; line-height: 1.3; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(211, 207, 201); clear: both; text-align: start; background-color: rgb(24, 26, 27);&quot;&gt;Syrinlya&lt;/h2&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="-100" y="6990" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;h3 data-path-to-node=&quot;1&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Syrinlya: Der Außenposten im ewigen Eis&lt;/font&gt;&lt;/b&gt;&lt;/h3&gt;&lt;ul data-path-to-node=&quot;2&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,0,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Charakter:&lt;/b&gt; Ein rauer, aber loyaler Zufluchtsort aus Jurten und Pelzzelten. Es ist eine Siedlung von Glücksrittern und Söldnern, die gekommen sind, um in den Ruinen von Aeor reich zu werden.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;2,1,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;2,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Einwohner:&lt;/b&gt; 182 Personen (72% Zwerge, 24% Elfen, 4% Sonstige). Fast alle stammen aus der Doppelstadt &lt;b data-path-to-node=&quot;2,1,0&quot; data-index-in-node=&quot;100&quot;&gt;Uthodurn&lt;/b&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr data-path-to-node=&quot;3&quot;&gt;&lt;h3 data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Gesellschaft &amp;amp; Ordnung&lt;/font&gt;&lt;/b&gt;&lt;/h3&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Führung:&lt;/b&gt; &lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;9&quot;&gt;Professor Gulrim Shalebrow&lt;/b&gt; (ernannt von Königin Fruunast). Er ist oft selbst auf Expeditionen und lässt den Entdeckern große Freiheit.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Das „Gesetz“:&lt;/b&gt; Es gibt kaum formale Gesetze, aber einen strengen &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;64&quot;&gt;Ehrenkodex&lt;/b&gt;. Man hilft sich gegenseitig (Teilen von Nahrung, Schutz vor der Kälte). Wer andere schikaniert oder stiehlt, bekommt es mit den stärksten Entdeckern (wie &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;229&quot;&gt;Morgo Delwur&lt;/b&gt;) zu tun, die das Recht selbst in die Hand nehmen.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Verteidigung:&lt;/b&gt; Es gibt keine Stadtwache. Da jeder hier ein abgehärteter Entdecker ist, ist die gesamte Bevölkerung bewaffnet und kampfbereit&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="260" width="590" x="770" y="7120" as="geometry" />
        </mxCell>
        <UserObject label="&lt;img src=&quot;https://www.dndreinkarnated.com/content/images/2023/04/Syrinlya--DM-Version-.jpg&quot; alt=&quot;Syrinlya&quot;&gt;" link="&lt;img src=&quot;https://www.dndreinkarnated.com/content/images/2023/04/Syrinlya--DM-Version-.jpg&quot; alt=&quot;Syrinlya&quot;&gt;" id="_KPzVuf8w2iddTT2j93n-3">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="40" width="30" x="1900" y="7180" as="geometry" />
          </mxCell>
