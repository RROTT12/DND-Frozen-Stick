        <mxCell id="n4fE8acd2FAlWuIs1wk2-50" parent="1" style="whiteSpace=wrap;html=1;" value="S12" vertex="1">
          <mxGeometry height="60" width="120" x="810" y="15590" as="geometry" />
        </mxCell>
        <UserObject label="&lt;aside class=&quot;text--quote-box&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; display: flex; --compendium-p-bottom: 0; background-color: rgb(241, 228, 200); padding: 15px 25px; position: relative; width: auto; flex-direction: column; overflow: visible; border-radius: 0px; border-width: 0px 1px; border-left-style: solid; border-right-style: solid; border-right-color: rgb(175, 142, 88); border-left-color: rgb(175, 142, 88); border-top-style: initial; border-top-color: initial; border-bottom-style: initial; border-bottom-color: initial; color: rgb(34, 34, 34); margin: 40px 0px; line-height: 1.6; font-size: 14px; font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px; width: 798px;&quot;&gt;The remains of broken tables and chairs are piled along the east wall. Two human zombies in tattered robes shuffle aimlessly around each other at the center of the chamber.&lt;/p&gt;&lt;/aside&gt;&lt;p data-content-chunk-id=&quot;342a9e84-01f2-42b1-ae51-9bcf0db435d3&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The two&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;zombies&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;occupying the dining hall attack any intruders. All the other features of this room have been reduced to rubble.&lt;/p&gt;" link="&lt;aside class=&quot;text--quote-box&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; display: flex; --compendium-p-bottom: 0; background-color: rgb(241, 228, 200); padding: 15px 25px; position: relative; width: auto; flex-direction: column; overflow: visible; border-radius: 0px; border-width: 0px 1px; border-left-style: solid; border-right-style: solid; border-right-color: rgb(175, 142, 88); border-left-color: rgb(175, 142, 88); border-top-style: initial; border-top-color: initial; border-bottom-style: initial; border-bottom-color: initial; color: rgb(34, 34, 34); margin: 40px 0px; line-height: 1.6; font-size: 14px; font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px; width: 798px;&quot;&gt;The remains of broken tables and chairs are piled along the east wall. Two human zombies in tattered robes shuffle aimlessly around each other at the center of the chamber.&lt;/p&gt;&lt;/aside&gt;&lt;p data-content-chunk-id=&quot;342a9e84-01f2-42b1-ae51-9bcf0db435d3&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The two&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;zombies&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;occupying the dining hall attack any intruders. All the other features of this room have been reduced to rubble.&lt;/p&gt;" id="n4fE8acd2FAlWuIs1wk2-51">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="230" width="560" x="900" y="15680" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-52" parent="1" style="whiteSpace=wrap;html=1;" value="S13" vertex="1">
          <mxGeometry height="60" width="120" x="1930" y="15020" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-53" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Wasser ebbt und fließt durch eine große Öffnung in der Ostwand dieser ruinierten Bibliothek. Verrottende Pergamente und vollgesogene Wälzer liegen überall verstreut, herabgefallen aus rissigen Steinregalen.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="1970" y="15127" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-54" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h4 data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;1. Verborgene Gefahr&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Tiefes Wasser:&lt;/b&gt; Unter den schwimmenden Büchern und Pergamenten ist das Wasser tiefer als gedacht. Der Boden im östlichen Teil ist eingestürzt und das Wasser ist dort &lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;165&quot;&gt;4,5 Meter (15 Fuß) tief&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Jäger:&lt;/b&gt; Ein &lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;15&quot;&gt;Riesenkrake (Giant Octopus)&lt;/b&gt; hat sich hier eingenistet.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Entdeckung:&lt;/b&gt; Um ihn zu bemerken, muss ein Charakter einen Wurf auf &lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;66&quot;&gt;Weisheit (Wahrnehmung)&lt;/b&gt; schaffen, der höher ist als der Wurf des Kraken auf &lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;141&quot;&gt;Geschicklichkeit (Heimlichkeit)&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,3,0&quot;&gt;&lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Hinweis:&lt;/b&gt; Das Wasser ist extrem kalt (siehe die allgemeinen Salsvault-Regeln zum Erschöpfungsrisiko durch Kälte).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;2. Schatz&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Fundstück:&lt;/b&gt; Ein wasserdichter Schriftrollenbehälter treibt im Wasser.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Entdeckung:&lt;/b&gt; Erforderlich ist eine &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;34&quot;&gt;passive Wahrnehmung von 12&lt;/b&gt; (oder ein erfolgreicher &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;85&quot;&gt;DC 12 Weisheit/Wahrnehmung Check&lt;/b&gt;).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Inhalt:&lt;/b&gt; Der Behälter enthält zwei &lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;34&quot;&gt;Schriftrollen (Spell Scrolls) für &lt;i data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;68&quot;&gt;Magie entdecken (Detect Magic)&lt;/i&gt;&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="390" width="560" x="1960" y="15240" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-55" parent="1" style="whiteSpace=wrap;html=1;" value="S14" vertex="1">
          <mxGeometry height="60" width="120" x="1910" y="15690" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Three well-preserved human&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;zombies&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in tattered robes roam this hall aimlessly, attacking any intruders that catch their attention.&lt;/span&gt;" link="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Three well-preserved human&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;zombies&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in tattered robes roam this hall aimlessly, attacking any intruders that catch their attention.&lt;/span&gt;" id="n4fE8acd2FAlWuIs1wk2-56">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="60" width="560" x="1990" y="15782" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-57" parent="1" style="whiteSpace=wrap;html=1;" value="S15" vertex="1">
          <mxGeometry height="60" width="120" x="2628" y="15010" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-58" parent="1" style="text;whiteSpace=wrap;html=1;" value="Zerbrochene Klingen, rissige Hämmer, vom Frost zerfressene Speere und andere ruinierte Waffen liegen auf dem Boden verstreut – herabgefallen von den leeren Waffenständern aus Eisen, die die Wände säumen." vertex="1">
          <mxGeometry height="70" width="560" x="2770" y="15127" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p data-content-chunk-id=&quot;65c98a4d-861d-417a-ae6d-4fd5a6f0853c&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The mages of Salsvault stored animated weapons in this room, most of which were destroyed in the crash. Five&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16865-flying-sword&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16865-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flying swords&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;lay among the debris, attacking any characters who enter.&lt;/p&gt;&lt;p data-content-chunk-id=&quot;22ca7f39-a350-4163-9a6d-29ea1cbddfc1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The broken weapons on the floor make this area&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover rule-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/basic-rules/adventuring#DifficultTerrain&quot; data-tooltip-href=&quot;//www.dndbeyond.com/rules/86-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(155, 116, 11) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;difficult terrain&lt;/a&gt;. Any creature that falls&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover condition-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/dnd/free-rules/rules-glossary#ProneCondition&quot; data-tooltip-href=&quot;//www.dndbeyond.com/conditions/12-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(17, 136, 76) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;prone&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in this room takes 2 (1d4) piercing damage.&lt;/p&gt;" link="&lt;p data-content-chunk-id=&quot;65c98a4d-861d-417a-ae6d-4fd5a6f0853c&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The mages of Salsvault stored animated weapons in this room, most of which were destroyed in the crash. Five&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16865-flying-sword&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16865-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flying swords&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;lay among the debris, attacking any characters who enter.&lt;/p&gt;&lt;p data-content-chunk-id=&quot;22ca7f39-a350-4163-9a6d-29ea1cbddfc1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The broken weapons on the floor make this area&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover rule-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/basic-rules/adventuring#DifficultTerrain&quot; data-tooltip-href=&quot;//www.dndbeyond.com/rules/86-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(155, 116, 11) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;difficult terrain&lt;/a&gt;. Any creature that falls&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover condition-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/dnd/free-rules/rules-glossary#ProneCondition&quot; data-tooltip-href=&quot;//www.dndbeyond.com/conditions/12-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(17, 136, 76) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;prone&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in this room takes 2 (1d4) piercing damage.&lt;/p&gt;" id="n4fE8acd2FAlWuIs1wk2-59">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="120" width="560" x="2748" y="15240" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-60" parent="1" style="whiteSpace=wrap;html=1;" value="S17" vertex="1">
          <mxGeometry height="60" width="120" x="-140" y="16280" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-61" parent="1" style="text;whiteSpace=wrap;html=1;" value="Ein großes rotes X ist quer über die Steintür vor euch gemalt. Heftiges Hämmern und das Geräusch schwerer Gegenstände, die umhergeworfen werden, dringen aus der Kammer dahinter." vertex="1">
          <mxGeometry height="50" width="560" x="1990" y="15910" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-62" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="On Nearing Door S16" vertex="1">
          <mxGeometry height="30" width="140" x="1890" y="15875" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-63" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;The door is locked. If the characters open it, read:&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="390" x="1990" y="15960" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-64" parent="1" style="whiteSpace=wrap;html=1;" value="S16" vertex="1">
          <mxGeometry height="60" width="120" x="2630" y="15430" as="geometry" />
        </mxCell>
        <mxCell id="n4fE8acd2FAlWuIs1wk2-65" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Als ihr die Tür zu diesem trümmergefüllten Raum öffnet, stürmt eine humanoide Kreatur aus zusammengenähten Fleischstücken auf euch zu. Der Körper des Monsters ist überät mit Wunden, und gebrochene Knochenstücke ragen in seltsamen Winkeln aus seiner Haut&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="2790" y="15480" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p data-content-chunk-id=&quot;9490c311-4144-42f1-ab38-90f0fa18be0e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;When Salsvault crashed into Foren, this golem servant of the mages was driven mad from the damage it took. Ferol locked the golem in this room ages ago. The&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744309-damaged-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744309-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;uses the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16863-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16863-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flesh golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;stat block, with these changes:&lt;/p&gt;&lt;ul data-content-chunk-id=&quot;e8ad95c0-519c-4fa2-90f6-2d0c31e3ac22&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; list-style: initial; margin: 0px 0px 0px 19.5px; padding: 15px; line-height: 30px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li data-content-chunk-id=&quot;20fb4c56-9237-487b-b536-5045e08f9c8e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has 5 hit points remaining, and its Berserk trait is activated.&lt;/li&gt;&lt;li data-content-chunk-id=&quot;787ad2e8-59c0-456e-bdce-7ccfb4007522&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has the use of only one arm and can’t use its Multiattack. Its challenge rating is 1 (200 XP).&lt;/li&gt;&lt;/ul&gt;&lt;h4 id=&quot;Debris&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;4d80b389-1f0f-4115-9997-49a7a20e738d&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 6.5px 0px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#Debris&quot; data-content-chunk-id=&quot;ccecb326-724e-4bac-a529-fe708c6c493e&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Debris&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;58c178f6-88fd-4d94-b182-e212b85696a0&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The golem has long since smashed all the objects in this chamber not destroyed by Salsvault’s crash. Any search of the debris turns up only bits of bone, clay, iron, stone, and paper.&lt;/p&gt;" link="&lt;p data-content-chunk-id=&quot;9490c311-4144-42f1-ab38-90f0fa18be0e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;When Salsvault crashed into Foren, this golem servant of the mages was driven mad from the damage it took. Ferol locked the golem in this room ages ago. The&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744309-damaged-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744309-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;uses the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16863-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16863-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flesh golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;stat block, with these changes:&lt;/p&gt;&lt;ul data-content-chunk-id=&quot;e8ad95c0-519c-4fa2-90f6-2d0c31e3ac22&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; list-style: initial; margin: 0px 0px 0px 19.5px; padding: 15px; line-height: 30px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li data-content-chunk-id=&quot;20fb4c56-9237-487b-b536-5045e08f9c8e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has 5 hit points remaining, and its Berserk trait is activated.&lt;/li&gt;&lt;li data-content-chunk-id=&quot;787ad2e8-59c0-456e-bdce-7ccfb4007522&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has the use of only one arm and can’t use its Multiattack. Its challenge rating is 1 (200 XP).&lt;/li&gt;&lt;/ul&gt;&lt;h4 id=&quot;Debris&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;4d80b389-1f0f-4115-9997-49a7a20e738d&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 6.5px 0px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#Debris&quot; data-content-chunk-id=&quot;ccecb326-724e-4bac-a529-fe708c6c493e&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Debris&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;58c178f6-88fd-4d94-b182-e212b85696a0&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The golem has long since smashed all the objects in this chamber not destroyed by Salsvault’s crash. Any search of the debris turns up only bits of bone, clay, iron, stone, and paper.&lt;/p&gt;" id="n4fE8acd2FAlWuIs1wk2-66">
