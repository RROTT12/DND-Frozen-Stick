solation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(212, 209, 203) none 0px; overlay: none; padding: 0px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;Koch:&lt;/b&gt; Betreibt die Gemeinschaftsküche.&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 1px solid; inset: auto; clear: none; clip: auto; color: rgb(212, 209, 203); columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: table-cell; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(212, 209, 203) none 0px; overlay: none; padding: 8px 12px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;&lt;span data-path-to-node=&quot;2,6,3,0&quot; style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 0px none rgb(212, 209, 203); inset: auto; clear: none; clip: auto; color: rgb(212, 209, 203); columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: inline; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(212, 209, 203) none 0px; overlay: none; padding: 0px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;2,6,3,0&quot; data-index-in-node=&quot;0&quot; style=&quot;animation: 0s ease 0s 1 normal none running none; appearance: none; background: none 0% 0% / auto repeat scroll padding-box border-box rgba(0, 0, 0, 0); border: 0px none rgb(212, 209, 203); inset: auto; clear: none; clip: auto; color: rgb(212, 209, 203); columns: auto; contain: none; container: none; content: normal; cursor: auto; cx: 0px; cy: 0px; d: none; direction: ltr; display: inline; fill: rgb(0, 0, 0); filter: none; flex: 0 1 auto; float: none; gap: normal; hyphens: manual; interactivity: auto; isolation: auto; margin-top: 0px !important; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; marker: none; mask: none; offset: normal; opacity: 1; order: 0; orphans: 2; outline: rgb(212, 209, 203) none 0px; overlay: none; padding: 0px; page: auto; perspective: none; position: static; quotes: auto; r: 0px; resize: none; rotate: none; rx: auto; ry: auto; scale: none; speak: normal; stroke: none; transform: none; transition: all; translate: none; visibility: visible; widows: 2; x: 0px; y: 0px; zoom: 1; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important;&quot;&gt;Warme Decken&lt;/b&gt; &amp;amp; kleine Fläschchen mit scharfem Kräuterschnaps (gegen Kälte).&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="610" width="730" x="-910" y="7190" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-5" edge="1" parent="1" source="LJnpm5BnixMahp6EwiEF-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1.002;entryY=0.229;entryDx=0;entryDy=0;entryPerimeter=0;" target="_KPzVuf8w2iddTT2j93n-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Wichtige Regeln für den Handel in Syrinlya:&lt;/font&gt;&lt;/b&gt;&lt;/h3&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Tauschhandel:&lt;/b&gt; Da es keine richtige Bank gibt, bevorzugen die NPCs oft den Tausch gegen Dinge, die sie selbst nicht herstellen können (frisches Obst vom Schiff, Wein, exotische Gewürze oder Werkzeuge aus dem Süden).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der „Käufer“-Bonus:&lt;/b&gt; Wenn die Spieler aeorische Relikte finden, können sie diese nur beim &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;89&quot;&gt;Käufer&lt;/b&gt; (The Buyer) gegen richtiges Gold oder seltene magische Gefälligkeiten eintauschen. Die normalen NPCs tauschen nur für den täglichen Bedarf.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Preise:&lt;/b&gt; Die Preise sind etwa doppelt so hoch wie im Spielerhandbuch, da der Transport nach Eiselcross extrem gefährlich ist.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="350" width="720" x="730" y="7730" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;1&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Morgo Delwur&lt;/font&gt;&lt;/b&gt;&lt;/h3&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;i data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Zwergenfrau, Werbärin (Neutral Gut)&lt;/font&gt;&lt;/i&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Erscheinung:&lt;/b&gt; Eine kräftige Gebirgszwergin mit einer wilden, struppigen Mähne aus ungepflegtem Haar. Trotz der beißenden Kälte wirkt sie völlig unbeeindruckt und trägt ihre Kleidung oft etwas lockerer als andere.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Persönlichkeit:&lt;/b&gt; Laut, herzlich und humorvoll. Sie ist das inoffizielle „Willkommenskomitee“ und eine der moralischen Instanzen in Syrinlya. Sie hasst Tyrannen und hält an Groll fest, ist aber eine loyale Freundin.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Funktion für die Gruppe:&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;3,2,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,1,0,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,2,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Guide:&lt;/b&gt; Zeigt den Spielern das Lager und führt sie zu &lt;b data-path-to-node=&quot;3,2,1,0,0&quot; data-index-in-node=&quot;53&quot;&gt;Orvo Mustave&lt;/b&gt; oder zum &lt;b data-path-to-node=&quot;3,2,1,0,0&quot; data-index-in-node=&quot;75&quot;&gt;Käufer&lt;/b&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,1,1,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,2,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Wissensquelle:&lt;/b&gt; Sie kennt die Details des Lagers und weiß über das &lt;b data-path-to-node=&quot;3,2,1,1,0&quot; data-index-in-node=&quot;66&quot;&gt;Frostleid (Frigid Woe)&lt;/b&gt; und dessen tödliche Wirkung Bescheid.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,1,2,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,2,1,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Urgons Tod:&lt;/b&gt; Sie war keine enge Freundin von Urgon, ist aber sichtlich betrübt über die Nachricht seines Todes – in der kleinen Gemeinschaft von Eiselcross zählt jeder Kopf.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,3,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Besonderheit:&lt;/b&gt; Da sie eine &lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;26&quot; style=&quot;&quot;&gt;Werbärin&lt;/b&gt; ist, verfügt sie über eine natürliche Resistenz gegen die Kälte und physische Angriffe. Sie verwandelt sich nur im Notfall, um den Außenposten zu verteidigen.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="420" width="560" x="50" y="7560" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-9" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;0&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Morgo deutet auf die Gruppen von Zwergen und Elfen, die sich um die Lagerfeuer drängen und miteinander plaudern. „Sie planen Expeditionen, um Aeors verlorene Schätze zu finden“, sagt sie. „Darum dreht sich hier alles. Wenn du nicht am Erkunden bist, machst du auch kein Gold.“&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;2&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Die Zwergin bleibt vor einer großen, mit Pelz ausgekleideten Jurte stehen. „Hier könnt ihr bleiben. Gehörte einem närrischen, reichen Elfen namens Bertron, der hierherkam, um das Abenteuer zu suchen. Stattdessen fand er das Innere eines Säbelzahntigers. Es sollten noch Vorräte und so Zeug da drin sein. Gehört jetzt alles euch.“&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="560" x="86" y="8170" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-10" parent="1" style="whiteSpace=wrap;html=1;" value="Bertons Yurt" vertex="1">
          <mxGeometry height="60" width="120" x="-90" y="8275" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-12" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;7&quot;&gt;&lt;b data-path-to-node=&quot;7&quot; data-index-in-node=&quot;0&quot;&gt;Wirtschaft&lt;/b&gt;&lt;/h3&gt;&lt;ul data-path-to-node=&quot;8&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Handel:&lt;/b&gt; Man tauscht gegen den täglichen Bedarf (einfache Ausrüstung, Vorräte).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der „Käufer“ (The Buyer):&lt;/b&gt; Die einzige Adresse, um wertvolle aeorische Artefakte direkt zu verkaufen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,2,0&quot;&gt;&lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Ziel:&lt;/b&gt; Jeder hier ist entweder auf der Jagd nach Wissen oder nach Gold.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="160" width="560" x="770" y="7540" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-22" edge="1" parent="1" source="_KPzVuf8w2iddTT2j93n-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="_KPzVuf8w2iddTT2j93n-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-13" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;contains 50 days of rations (Dry Meat),&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;a 50-foot silk rope,&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&amp;nbsp;a blanket,&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&amp;nbsp;a grappling hook,&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&amp;nbsp;a miner’s pick,&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;and a book titled&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;em style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Adventure Sexy: Impress Potential Lovers with Great Deeds&lt;/em&gt;&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&amp;nbsp;by Scanlan Shorthalt.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="560" x="700" y="8335" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;The Create&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="100" x="740" y="8275" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-16" parent="1" style="whiteSpace=wrap;html=1;" value="The Buyer" vertex="1">
          <mxGeometry height="60" width="120" x="-70" y="8940" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-20" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Das Heulen des Windes und die beißende Kälte lassen nach, sobald ihr die Jurte betretet. Eine kalte Feuerstelle markiert die Mitte des mit Fellen ausgelegten Bodens. Neben der Tür steht eine offene Kiste, die abgepackte Rationen und ein paar andere Gegenstände enthält.“&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="86" y="8440" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-21" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;4,1&quot;&gt;„... und so sage ich euch, meine Freunde: Es reicht nicht, den Drachen einfach nur zu töten. Jeder kann ein Monster erstechen, wenn er groß genug ist. Aber ein wahrer Held – ein &lt;i data-path-to-node=&quot;4,1&quot; data-index-in-node=&quot;178&quot;&gt;sexy&lt;/i&gt; Held – tut es, während sein Haar perfekt im Wind weht und er einen Spruch auf den Lippen hat, der die Umstehenden vor Ehrfurcht (und Verlangen) erbeben lässt.&lt;/p&gt;&lt;p data-path-to-node=&quot;4,2&quot;&gt;Wenn ihr eine potenzielle Eroberung beeindrucken wollt, achtet auf die &lt;b data-path-to-node=&quot;4,2&quot; data-index-in-node=&quot;71&quot;&gt;Drei-Schritte-Regel&lt;/b&gt;:&lt;/p&gt;&lt;ol start=&quot;1&quot; data-path-to-node=&quot;4,3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;4,3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Pose:&lt;/b&gt; Ein Fuß auf den Kopf der Bestie. Immer. Das lässt die Waden muskulöser wirken.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;4,3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Augenkontakt:&lt;/b&gt; Schaut nicht auf das Gold. Schaut direkt in die Seele eures Publikums, als wolltet ihr sagen: ‚Ja, das war Absicht.‘&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;4,3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Die Musik:&lt;/b&gt; Wenn ihr keinen Barden dabei habt (was euer erster Fehler war), summt euer eigenes Intro-Thema. Es verleiht dem Moment die nötige Gravitas.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p data-path-to-node=&quot;4,4&quot;&gt;Denkt daran: Heldentum vergeht, aber ein verdammt guter erster Eindruck hält ewig.&lt;/p&gt;&lt;p data-path-to-node=&quot;4,5&quot;&gt;&lt;i data-path-to-node=&quot;4,5&quot; data-index-in-node=&quot;0&quot;&gt;Handschriftliche Notiz am Rand:&lt;/i&gt;&lt;br&gt;&lt;i data-path-to-node=&quot;4,5&quot; data-index-in-node=&quot;57&quot;&gt;Gilt das auch für Säbelzahntiger? Die Biester schauen nicht auf die Waden...&lt;/i&gt;“&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="560" x="1330" y="8275" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-23" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Der stechende Geruch von Weihrauch erfüllt diese Jurte, deren Wände mit leuchtenden arkane Runen bemalt sind. In der Mitte des Bodens brennt hell eine bronzene Feuerschale, um die herum einige weiche Plüschstühle, ein Bett und eine große Steinkiste stehen. Auf einem dieser Stühle sitzt ein Elf und liest ein Buch. Ein kleiner Drache mit grünen Schmetterlingsflügeln liegt zusammengerollt in seinem Schoß.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="560" x="106" y="9070" as="geometry" />
        </mxCell>
        <mxCell id="_KPzVuf8w2iddTT2j93n-24" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(211, 207, 201); font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(24, 26, 27); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;It is Syrinlya’s largest yurt. When the characters&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="415" x="106" y="8980" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
