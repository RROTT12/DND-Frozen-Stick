        <mxCell id="bB0-X0oldWWfwmH7fZuz-24" edge="1" parent="1" source="bB0-X0oldWWfwmH7fZuz-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="bB0-X0oldWWfwmH7fZuz-26">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2680" y="3600" />
