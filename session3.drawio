round: 0px center; max-width: 400px;&quot;&gt;18 miles&lt;/td&gt;&lt;td style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; vertical-align: middle; padding: 20px; border: 1px solid rgb(237, 234, 232); font-size: 14px; text-align: center; overflow-wrap: break-word; min-width: 100px; background: 0px center; max-width: 400px;&quot;&gt;24 miles&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; background: rgb(250, 247, 240); transition: 0.3s; color: rgb(34, 34, 34);&quot;&gt;&lt;td style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; vertical-align: middle; padding: 20px; border: 1px solid rgb(237, 234, 232); font-size: 14px; text-align: center; overflow-wrap: break-word; min-width: 100px; background: 0px center; max-width: 400px;&quot;&gt;5–10 ft.&lt;/td&gt;&lt;td style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; vertical-align: middle; padding: 20px; border: 1px solid rgb(237, 234, 232); font-size: 14px; text-align: center; overflow-wrap: break-word; min-width: 100px; background: 0px center; max-width: 400px;&quot;&gt;6 miles&lt;/td&gt;&lt;td style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; vertical-align: middle; padding: 20px; border: 1px solid rgb(237, 234, 232); font-size: 14px; text-align: center; overflow-wrap: break-word; min-width: 100px; background: 0px center; max-width: 400px;&quot;&gt;12 miles&lt;/td&gt;&lt;td style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; vertical-align: middle; padding: 20px; border: 1px solid rgb(237, 234, 232); font-size: 14px; text-align: center; overflow-wrap: break-word; min-width: 100px; background: 0px center; max-width: 400px;&quot;&gt;18 miles&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;" vertex="1">
