        <UserObject label="&lt;aside class=&quot;text--quote-box&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; display: flex; --compendium-p-bottom: 0; background-color: rgb(241, 228, 200); padding: 15px 25px; position: relative; width: auto; flex-direction: column; overflow: visible; border-radius: 0px; border-width: 0px 1px; border-left-style: solid; border-right-style: solid; border-right-color: rgb(175, 142, 88); border-left-color: rgb(175, 142, 88); border-top-style: initial; border-top-color: initial; border-bottom-style: initial; border-bottom-color: initial; color: rgb(34, 34, 34); margin: 40px 0px; line-height: 1.6; font-size: 14px; font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px; width: 798px;&quot;&gt;The remains of broken tables and chairs are piled along the east wall. Two human zombies in tattered robes shuffle aimlessly around each other at the center of the chamber.&lt;/p&gt;&lt;/aside&gt;&lt;p data-content-chunk-id=&quot;342a9e84-01f2-42b1-ae51-9bcf0db435d3&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The two&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;zombies&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;occupying the dining hall attack any intruders. All the other features of this room have been reduced to rubble.&lt;/p&gt;" link="&lt;aside class=&quot;text--quote-box&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; display: flex; --compendium-p-bottom: 0; background-color: rgb(241, 228, 200); padding: 15px 25px; position: relative; width: auto; flex-direction: column; overflow: visible; border-radius: 0px; border-width: 0px 1px; border-left-style: solid; border-right-style: solid; border-right-color: rgb(175, 142, 88); border-left-color: rgb(175, 142, 88); border-top-style: initial; border-top-color: initial; border-bottom-style: initial; border-bottom-color: initial; color: rgb(34, 34, 34); margin: 40px 0px; line-height: 1.6; font-size: 14px; font-family: Roboto, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;p style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px; width: 798px;&quot;&gt;The remains of broken tables and chairs are piled along the east wall. Two human zombies in tattered robes shuffle aimlessly around each other at the center of the chamber.&lt;/p&gt;&lt;/aside&gt;&lt;p data-content-chunk-id=&quot;342a9e84-01f2-42b1-ae51-9bcf0db435d3&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The two&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;zombies&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;occupying the dining hall attack any intruders. All the other features of this room have been reduced to rubble.&lt;/p&gt;" id="bB0-X0oldWWfwmH7fZuz-85">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="230" width="560" x="2770" y="9870" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-86" parent="1" style="whiteSpace=wrap;html=1;" value="S13" vertex="1">
          <mxGeometry height="60" width="120" x="3800" y="9210" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-87" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Wasser ebbt und fließt durch eine große Öffnung in der Ostwand dieser ruinierten Bibliothek. Verrottende Pergamente und vollgesogene Wälzer liegen überall verstreut, herabgefallen aus rissigen Steinregalen.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="3840" y="9317" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-88" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h4 data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;1. Verborgene Gefahr&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Tiefes Wasser:&lt;/b&gt; Unter den schwimmenden Büchern und Pergamenten ist das Wasser tiefer als gedacht. Der Boden im östlichen Teil ist eingestürzt und das Wasser ist dort &lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;165&quot;&gt;4,5 Meter (15 Fuß) tief&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Jäger:&lt;/b&gt; Ein &lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;15&quot;&gt;Riesenkrake (Giant Octopus)&lt;/b&gt; hat sich hier eingenistet.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Entdeckung:&lt;/b&gt; Um ihn zu bemerken, muss ein Charakter einen Wurf auf &lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;66&quot;&gt;Weisheit (Wahrnehmung)&lt;/b&gt; schaffen, der höher ist als der Wurf des Kraken auf &lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;141&quot;&gt;Geschicklichkeit (Heimlichkeit)&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,3,0&quot;&gt;&lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Hinweis:&lt;/b&gt; Das Wasser ist extrem kalt (siehe die allgemeinen Salsvault-Regeln zum Erschöpfungsrisiko durch Kälte).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;2. Schatz&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Fundstück:&lt;/b&gt; Ein wasserdichter Schriftrollenbehälter treibt im Wasser.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Entdeckung:&lt;/b&gt; Erforderlich ist eine &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;34&quot;&gt;passive Wahrnehmung von 12&lt;/b&gt; (oder ein erfolgreicher &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;85&quot;&gt;DC 12 Weisheit/Wahrnehmung Check&lt;/b&gt;).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Inhalt:&lt;/b&gt; Der Behälter enthält zwei &lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;34&quot;&gt;Schriftrollen (Spell Scrolls) für &lt;i data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;68&quot;&gt;Magie entdecken (Detect Magic)&lt;/i&gt;&lt;/b&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="390" width="560" x="3830" y="9430" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-89" parent="1" style="whiteSpace=wrap;html=1;" value="S14" vertex="1">
          <mxGeometry height="60" width="120" x="3780" y="9880" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Three well-preserved human&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;zombies&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in tattered robes roam this hall aimlessly, attacking any intruders that catch their attention.&lt;/span&gt;" link="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Three well-preserved human&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17077-zombie&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17077-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;zombies&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in tattered robes roam this hall aimlessly, attacking any intruders that catch their attention.&lt;/span&gt;" id="bB0-X0oldWWfwmH7fZuz-90">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="60" width="560" x="3860" y="9972" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-91" parent="1" style="whiteSpace=wrap;html=1;" value="S15" vertex="1">
          <mxGeometry height="60" width="120" x="4498" y="9200" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-92" parent="1" style="text;whiteSpace=wrap;html=1;" value="Zerbrochene Klingen, rissige Hämmer, vom Frost zerfressene Speere und andere ruinierte Waffen liegen auf dem Boden verstreut – herabgefallen von den leeren Waffenständern aus Eisen, die die Wände säumen." vertex="1">
          <mxGeometry height="70" width="560" x="4640" y="9317" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p data-content-chunk-id=&quot;65c98a4d-861d-417a-ae6d-4fd5a6f0853c&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The mages of Salsvault stored animated weapons in this room, most of which were destroyed in the crash. Five&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16865-flying-sword&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16865-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flying swords&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;lay among the debris, attacking any characters who enter.&lt;/p&gt;&lt;p data-content-chunk-id=&quot;22ca7f39-a350-4163-9a6d-29ea1cbddfc1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The broken weapons on the floor make this area&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover rule-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/basic-rules/adventuring#DifficultTerrain&quot; data-tooltip-href=&quot;//www.dndbeyond.com/rules/86-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(155, 116, 11) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;difficult terrain&lt;/a&gt;. Any creature that falls&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover condition-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/dnd/free-rules/rules-glossary#ProneCondition&quot; data-tooltip-href=&quot;//www.dndbeyond.com/conditions/12-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(17, 136, 76) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;prone&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in this room takes 2 (1d4) piercing damage.&lt;/p&gt;" link="&lt;p data-content-chunk-id=&quot;65c98a4d-861d-417a-ae6d-4fd5a6f0853c&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The mages of Salsvault stored animated weapons in this room, most of which were destroyed in the crash. Five&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16865-flying-sword&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16865-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flying swords&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;lay among the debris, attacking any characters who enter.&lt;/p&gt;&lt;p data-content-chunk-id=&quot;22ca7f39-a350-4163-9a6d-29ea1cbddfc1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The broken weapons on the floor make this area&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover rule-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/basic-rules/adventuring#DifficultTerrain&quot; data-tooltip-href=&quot;//www.dndbeyond.com/rules/86-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(155, 116, 11) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;difficult terrain&lt;/a&gt;. Any creature that falls&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover condition-tooltip&quot; href=&quot;https://www.dndbeyond.com/sources/dnd/free-rules/rules-glossary#ProneCondition&quot; data-tooltip-href=&quot;//www.dndbeyond.com/conditions/12-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(17, 136, 76) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;prone&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;in this room takes 2 (1d4) piercing damage.&lt;/p&gt;" id="bB0-X0oldWWfwmH7fZuz-93">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="120" width="560" x="4618" y="9430" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-94" parent="1" style="whiteSpace=wrap;html=1;" value="S17" vertex="1">
          <mxGeometry height="60" width="120" x="1730" y="10470" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-95" parent="1" style="text;whiteSpace=wrap;html=1;" value="Ein großes rotes X ist quer über die Steintür vor euch gemalt. Heftiges Hämmern und das Geräusch schwerer Gegenstände, die umhergeworfen werden, dringen aus der Kammer dahinter." vertex="1">
          <mxGeometry height="50" width="560" x="3860" y="10100" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-96" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="On Nearing Door S16" vertex="1">
          <mxGeometry height="30" width="140" x="3760" y="10065" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-97" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;The door is locked. If the characters open it, read:&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="390" x="3860" y="10150" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-98" parent="1" style="whiteSpace=wrap;html=1;" value="S16" vertex="1">
          <mxGeometry height="60" width="120" x="4500" y="9620" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-99" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Als ihr die Tür zu diesem trümmergefüllten Raum öffnet, stürmt eine humanoide Kreatur aus zusammengenähten Fleischstücken auf euch zu. Der Körper des Monsters ist überät mit Wunden, und gebrochene Knochenstücke ragen in seltsamen Winkeln aus seiner Haut&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="4660" y="9670" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p data-content-chunk-id=&quot;9490c311-4144-42f1-ab38-90f0fa18be0e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;When Salsvault crashed into Foren, this golem servant of the mages was driven mad from the damage it took. Ferol locked the golem in this room ages ago. The&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744309-damaged-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744309-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;uses the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16863-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16863-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flesh golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;stat block, with these changes:&lt;/p&gt;&lt;ul data-content-chunk-id=&quot;e8ad95c0-519c-4fa2-90f6-2d0c31e3ac22&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; list-style: initial; margin: 0px 0px 0px 19.5px; padding: 15px; line-height: 30px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li data-content-chunk-id=&quot;20fb4c56-9237-487b-b536-5045e08f9c8e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has 5 hit points remaining, and its Berserk trait is activated.&lt;/li&gt;&lt;li data-content-chunk-id=&quot;787ad2e8-59c0-456e-bdce-7ccfb4007522&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has the use of only one arm and can’t use its Multiattack. Its challenge rating is 1 (200 XP).&lt;/li&gt;&lt;/ul&gt;&lt;h4 id=&quot;Debris&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;4d80b389-1f0f-4115-9997-49a7a20e738d&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 6.5px 0px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#Debris&quot; data-content-chunk-id=&quot;ccecb326-724e-4bac-a529-fe708c6c493e&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Debris&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;58c178f6-88fd-4d94-b182-e212b85696a0&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The golem has long since smashed all the objects in this chamber not destroyed by Salsvault’s crash. Any search of the debris turns up only bits of bone, clay, iron, stone, and paper.&lt;/p&gt;" link="&lt;p data-content-chunk-id=&quot;9490c311-4144-42f1-ab38-90f0fa18be0e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;When Salsvault crashed into Foren, this golem servant of the mages was driven mad from the damage it took. Ferol locked the golem in this room ages ago. The&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744309-damaged-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744309-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;uses the&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/16863-flesh-golem&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/16863-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;flesh golem&lt;/a&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;stat block, with these changes:&lt;/p&gt;&lt;ul data-content-chunk-id=&quot;e8ad95c0-519c-4fa2-90f6-2d0c31e3ac22&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; list-style: initial; margin: 0px 0px 0px 19.5px; padding: 15px; line-height: 30px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li data-content-chunk-id=&quot;20fb4c56-9237-487b-b536-5045e08f9c8e&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has 5 hit points remaining, and its Berserk trait is activated.&lt;/li&gt;&lt;li data-content-chunk-id=&quot;787ad2e8-59c0-456e-bdce-7ccfb4007522&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px;&quot;&gt;The golem has the use of only one arm and can’t use its Multiattack. Its challenge rating is 1 (200 XP).&lt;/li&gt;&lt;/ul&gt;&lt;h4 id=&quot;Debris&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;4d80b389-1f0f-4115-9997-49a7a20e738d&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 6.5px 0px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#Debris&quot; data-content-chunk-id=&quot;ccecb326-724e-4bac-a529-fe708c6c493e&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Debris&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;58c178f6-88fd-4d94-b182-e212b85696a0&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The golem has long since smashed all the objects in this chamber not destroyed by Salsvault’s crash. Any search of the debris turns up only bits of bone, clay, iron, stone, and paper.&lt;/p&gt;" id="bB0-X0oldWWfwmH7fZuz-100">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="310" width="560" x="4550" y="9840" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-101" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-content-chunk-id=&quot;b2acce79-2060-4743-aa87-f510b5f80b7a&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;If the characters don’t earn Ferol’s trust, the wight attacks, fighting until destroyed.&lt;/p&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="1855" y="10670" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;The undead&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744310-ferol-sal&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744310-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;Ferol Sal&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;has worked tirelessly in the laboratory for centuries, obsessed with crafting a disease that can kill the gods. Despite having made no progress in all that time, he keeps working. Ferol is a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17059-wight&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17059-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;wight&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;with an Intelligence of 16 (+3).&lt;/span&gt;" link="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;The undead&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/744310-ferol-sal&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/744310-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;Ferol Sal&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;has worked tirelessly in the laboratory for centuries, obsessed with crafting a disease that can kill the gods. Despite having made no progress in all that time, he keeps working. Ferol is a&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;a class=&quot;tooltip-hover monster-tooltip&quot; href=&quot;https://www.dndbeyond.com/monsters/17059-wight&quot; data-tooltip-href=&quot;//www.dndbeyond.com/monsters/17059-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(188, 15, 15) !important; text-decoration: none; font-weight: bold !important; cursor: pointer; font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249);&quot;&gt;wight&lt;/a&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;with an Intelligence of 16 (+3).&lt;/span&gt;" id="bB0-X0oldWWfwmH7fZuz-102">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="100" width="560" x="1865" y="10556" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-103" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2 data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;Charakter-Profil: Ferol Sal&lt;/b&gt;&lt;/h2&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;0&quot;&gt;Status:&lt;/b&gt; Untoter (Wight) | &lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;26&quot;&gt;Sprachen:&lt;/b&gt; Archaisches Draconisch, Archaisches Elfisch (&lt;b data-path-to-node=&quot;3&quot; data-index-in-node=&quot;81&quot;&gt;kein&lt;/b&gt; Gemeinsprachig!)&lt;/p&gt;&lt;h3 data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;Persönlichkeit &amp;amp; Zustand&lt;/b&gt;&lt;/h3&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Wahnsinn:&lt;/b&gt; Die Jahrhunderte der Isolation und seine Verwandlung haben ihn in den Wahnsinn getrieben. Seine Erinnerungen an die ferne Vergangenheit sind verblasst.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Motivation:&lt;/b&gt; Sein einziger Antrieb ist &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;38&quot;&gt;Rache an den Göttern&lt;/b&gt;. Er geht (fälschlicherweise) davon aus, dass diese in Exandria noch immer aktiv eingreifen.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Wissensstand:&lt;/b&gt; Er hat keine Ahnung von der Geschichte Exandrias nach dem Absturz von Aeor.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h3 data-path-to-node=&quot;6&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;Interaktion mit der Gruppe&lt;/b&gt;&lt;/h3&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;&lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Erste Reaktion:&lt;/b&gt; Er ist misstrauisch und fordert sofort zu wissen, was die Charaktere in Salsvault zu suchen haben.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;&lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Kommunikation:&lt;/b&gt; Da er nur archaische Sprachen spricht, verläuft die Verständigung zäh (langsame Kommunikation für Charaktere mit Draconisch oder Elfisch).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,2,0&quot;&gt;&lt;b data-path-to-node=&quot;7,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Täuschung (Deception):&lt;/b&gt; Spieler können sein Vertrauen gewinnen, wenn sie behaupten, bei seiner Arbeit helfen zu wollen.&lt;/p&gt;&lt;ul data-path-to-node=&quot;7,2,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,2,1,0,0&quot;&gt;&lt;i data-path-to-node=&quot;7,2,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Mechanik:&lt;/i&gt; Charisma (Täuschung) gegen seinen Weisheit (Motiv erkennen) Wurf.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,2,1,1,0&quot;&gt;&lt;b data-path-to-node=&quot;7,2,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Vorteil:&lt;/b&gt; Wenn die Spieler die Notiz aus &lt;b data-path-to-node=&quot;7,2,1,1,0&quot; data-index-in-node=&quot;40&quot;&gt;S10&lt;/b&gt; gelesen haben und seinen Plan erwähnen, eine gott-tötende Seuche zu erschaffen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h3 data-path-to-node=&quot;8&quot;&gt;&lt;b data-path-to-node=&quot;8&quot; data-index-in-node=&quot;0&quot;&gt;Wichtige Informationen (bei Vertrauen)&lt;/b&gt;&lt;/h3&gt;&lt;ul data-path-to-node=&quot;9&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,0,0&quot;&gt;&lt;b data-path-to-node=&quot;9,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Warnung:&lt;/b&gt; Er weist sie an, sich vom Golem-Labor (&lt;b data-path-to-node=&quot;9,0,0&quot; data-index-in-node=&quot;48&quot;&gt;S16&lt;/b&gt;) fernzuhalten.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,1,0&quot;&gt;&lt;b data-path-to-node=&quot;9,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Das Heilmittel:&lt;/b&gt; Er bestätigt, dass sich das Heilmittel für &lt;i data-path-to-node=&quot;9,1,0&quot; data-index-in-node=&quot;59&quot;&gt;Frostleid (Frigid Woe)&lt;/i&gt; in einer Truhe im Heilmittel-Labor (&lt;b data-path-to-node=&quot;9,1,0&quot; data-index-in-node=&quot;118&quot;&gt;S18&lt;/b&gt;) befindet.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,2,0&quot;&gt;&lt;b data-path-to-node=&quot;9,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Der Schlüssel:&lt;/b&gt; Mit einem &lt;b data-path-to-node=&quot;9,2,0&quot; data-index-in-node=&quot;25&quot;&gt;DC 15 Charisma (Überzeugen)&lt;/b&gt; Check können die Spieler ihn dazu bringen, ihnen den Schlüssel für die Truhe in S18 auszuhändigen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="640" width="560" x="1010" y="10556" as="geometry" />
        </mxCell>
        <UserObject label="&lt;h4 id=&quot;FerolsKeys&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;60d56f00-4516-4497-99d7-f9212fb6c431&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 19.5px 0px 6.5px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Ferol’s Keys&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;836cdc8c-460b-4a81-a353-230daafc0f66&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Ferol carries two keys: one that works all the doors in Salsvault and another that works all the chests built into the floor within the complex (see “&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#SalsvaultFeatures&quot; data-content-chunk-id=&quot;96d0a736-630e-499e-9585-2a818d726d5f&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;Salsvault Features&lt;/a&gt;”).&lt;/p&gt;&lt;h4 id=&quot;FerolsLaboratoryShelves&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;7bd90f09-d359-4c8b-8235-ce3773b8c5c4&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 19.5px 0px 6.5px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#FerolsLaboratoryShelves&quot; data-content-chunk-id=&quot;d27b478a-5cd9-49ce-9b3f-e53a5f5e2f85&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Shelves&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;fcef7cef-8657-44e3-a8ca-ac0646d9f8ec&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The shelves hold spell components, reagents, and laboratory supplies that are far past their prime. However, a character who spends a few minutes searching the shelves can collect enough workable tools and reagents to put together a set of&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover item-tooltip&quot; href=&quot;https://www.dndbeyond.com/equipment/102-alchemists-supplies&quot; data-tooltip-href=&quot;//www.dndbeyond.com/adventuring-gear/102-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(119, 69, 33) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;alchemist’s supplies&lt;/a&gt;.&lt;/p&gt;&lt;h4 id=&quot;FerolsLaboratoryTables&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;9cf3f551-cd04-401c-96c6-cef12865f9d2&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 19.5px 0px 6.5px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#FerolsLaboratoryTables&quot; data-content-chunk-id=&quot;e2f1cf63-d4de-4004-bf80-62740aea2bd2&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Tables&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;97f319ec-55cf-4378-843e-20891a23d653&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Each table holds a working set of alchemist’s supplies that Ferol uses to experiment with frigid woe. If a creature is forcibly moved into a table, the delicate equipment on that table breaks and the creature must succeed on a DC 11 Constitution saving throw or contract frigid woe.&lt;/p&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;" link="&lt;h4 id=&quot;FerolsKeys&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;60d56f00-4516-4497-99d7-f9212fb6c431&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 19.5px 0px 6.5px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Ferol’s Keys&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;836cdc8c-460b-4a81-a353-230daafc0f66&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Ferol carries two keys: one that works all the doors in Salsvault and another that works all the chests built into the floor within the complex (see “&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#SalsvaultFeatures&quot; data-content-chunk-id=&quot;96d0a736-630e-499e-9585-2a818d726d5f&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;Salsvault Features&lt;/a&gt;”).&lt;/p&gt;&lt;h4 id=&quot;FerolsLaboratoryShelves&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;7bd90f09-d359-4c8b-8235-ce3773b8c5c4&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 19.5px 0px 6.5px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#FerolsLaboratoryShelves&quot; data-content-chunk-id=&quot;d27b478a-5cd9-49ce-9b3f-e53a5f5e2f85&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Shelves&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;fcef7cef-8657-44e3-a8ca-ac0646d9f8ec&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;The shelves hold spell components, reagents, and laboratory supplies that are far past their prime. However, a character who spends a few minutes searching the shelves can collect enough workable tools and reagents to put together a set of&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;a class=&quot;tooltip-hover item-tooltip&quot; href=&quot;https://www.dndbeyond.com/equipment/102-alchemists-supplies&quot; data-tooltip-href=&quot;//www.dndbeyond.com/adventuring-gear/102-tooltip?disable-webm=1&amp;amp;disable-webm=1&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(119, 69, 33) !important; text-decoration: none; font-weight: bold !important; cursor: pointer;&quot;&gt;alchemist’s supplies&lt;/a&gt;.&lt;/p&gt;&lt;h4 id=&quot;FerolsLaboratoryTables&quot; class=&quot;compendium-hr heading-anchor&quot; data-content-chunk-id=&quot;9cf3f551-cd04-401c-96c6-cef12865f9d2&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 19.5px 0px 6.5px; font-family: Roboto, Helvetica, sans-serif; font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: normal; overflow-wrap: break-word; scroll-margin-top: 16px; color: rgb(34, 34, 34); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;a href=&quot;https://www.dndbeyond.com/sources/dnd/egtw/adventures-in-wildemount-frozen-sick#FerolsLaboratoryTables&quot; data-content-chunk-id=&quot;e2f1cf63-d4de-4004-bf80-62740aea2bd2&quot; aria-hidden=&quot;true&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; color: rgb(0, 106, 190); text-decoration: none; cursor: pointer;&quot;&gt;&lt;/a&gt;Tables&lt;/h4&gt;&lt;p data-content-chunk-id=&quot;97f319ec-55cf-4378-843e-20891a23d653&quot; style=&quot;box-sizing: inherit; -webkit-tap-highlight-color: transparent; outline: 0px; margin: 0px 0px 12px; width: 850px; color: rgb(34, 34, 34); font-family: Roboto, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(249, 249, 249); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Each table holds a working set of alchemist’s supplies that Ferol uses to experiment with frigid woe. If a creature is forcibly moved into a table, the delicate equipment on that table breaks and the creature must succeed on a DC 11 Constitution saving throw or contract frigid woe.&lt;/p&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;" id="bB0-X0oldWWfwmH7fZuz-104">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="350" width="560" x="1840" y="10750" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-105" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-path-to-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Hier ist die Zusammenfassung der verbleibenden Details für &lt;b data-path-to-node=&quot;0&quot; data-index-in-node=&quot;59&quot; style=&quot;&quot;&gt;Raum S15 (Labor)&lt;/b&gt;:&lt;/font&gt;&lt;/p&gt;&lt;h3 data-path-to-node=&quot;1&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;S15: Ferols Ausrüstung &amp;amp; Die Laborgefahren&lt;/font&gt;&lt;/b&gt;&lt;/h3&gt;&lt;h4 data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;1. Ferols Schlüssel&lt;/font&gt;&lt;/b&gt;&lt;/h4&gt;&lt;p data-path-to-node=&quot;3&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Ferol trägt zwei wichtige Schlüssel bei sich, die das Erkunden des Komplexes massiv erleichtern:&lt;/font&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;4&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,0,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;4,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Schlüssel A:&lt;/b&gt; Öffnet &lt;b data-path-to-node=&quot;4,0,0&quot; data-index-in-node=&quot;20&quot;&gt;alle Türen&lt;/b&gt; in Salsvault.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;4,1,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Schlüssel B:&lt;/b&gt; Öffnet &lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;20&quot;&gt;alle im Boden eingelassenen Truhen&lt;/b&gt; (damit lassen sich die Kältefallen an den Truhen umgehen).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;5&quot;&gt;&lt;b data-path-to-node=&quot;5&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;2. Die Regale (Beute)&lt;/font&gt;&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;6&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,0,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Obwohl die meisten Reagenzien und Vorräte ihre Blütezeit längst hinter sich haben, lässt sich hier etwas Nützliches finden.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;6,1,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Suche:&lt;/b&gt; Wer ein paar Minuten investiert, kann genug brauchbare Werkzeuge und Zutaten finden, um ein komplettes Set &lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;114&quot;&gt;Alchemistenvorräte (Alchemist’s Supplies)&lt;/b&gt; zusammenzustellen.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;7&quot;&gt;&lt;b data-path-to-node=&quot;7&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;3. Die Tische (Gefahrenquelle)&lt;/font&gt;&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;8&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Auf jedem der sechs Tische steht eine einsatzbereite Alchemie-Ausrüstung, mit der Ferol am &lt;i data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;91&quot;&gt;Frostleid&lt;/i&gt; experimentiert.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Mechanik:&lt;/b&gt; Wenn eine Kreatur &lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;28&quot;&gt;gewaltsam gegen einen Tisch gestoßen&lt;/b&gt; wird (z. B. durch einen Stoß-Angriff oder Zauber), bricht die Ausrüstung.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,2,0&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Infektionsgefahr:&lt;/b&gt; In diesem Fall muss die Kreatur einen &lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;56&quot; style=&quot;&quot;&gt;DC 11 Konstitutionsrettungswurf&lt;/b&gt; bestehen oder sie infiziert sich sofort mit &lt;b data-path-to-node=&quot;8,2,0&quot; data-index-in-node=&quot;132&quot; style=&quot;&quot;&gt;Frostleid (Frigid Woe)&lt;/b&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="530" width="560" x="1830" y="11130" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-106" parent="1" style="whiteSpace=wrap;html=1;" value="S18" vertex="1">
          <mxGeometry height="60" width="120" x="2820" y="10470" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-107" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;Ein kalter Wind heult durch die eingestürzte Ostwand dieser riesigen Kammer, deren gegenüberliegende Seite vollständig unter eiskaltem Meerwasser liegt. Ein dichter Teppich aus Kelp wächst vom überfluteten Boden empor und verdeckt jegliche Sicht auf das, was sich darunter befindet. Zerbrochenes Glas und die Überreste zertrümmerter Tische bedecken den Boden im trockenen Teil des Raumes.“&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="560" x="2980" y="10530" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-108" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h4 data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;1. Historie &amp;amp; Gefahr&lt;/font&gt;&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Zweck:&lt;/b&gt; Früher stellten die Magier von Aeor hier die Heilmittel für ihre künstlichen Krankheiten her, um Unfälle im Griff zu behalten.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,1,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Wächter:&lt;/b&gt; &lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Vier &lt;b data-path-to-node=&quot;3,1,0&quot; data-index-in-node=&quot;14&quot;&gt;Riesenkrappen (Giant Crabs)&lt;/b&gt;&lt;/font&gt; haben sich unter dem Kelp eingenistet.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,2,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Hinterhalt:&lt;/b&gt; Charaktere benötigen eine &lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;38&quot;&gt;passive Wahrnehmung von 14&lt;/b&gt;, um sie zu bemerken. Andernfalls greifen die Krabben mit einem &lt;b data-path-to-node=&quot;3,2,0&quot; data-index-in-node=&quot;128&quot;&gt;Überraschungsangriff&lt;/b&gt; an.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,3,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Terrain:&lt;/b&gt; Das Wasser ist etwa &lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;29&quot;&gt;1,5 Meter (5 Fuß) tief&lt;/b&gt;. Der dichte Kelp macht das Wasser für alle (außer den Krabben) zu &lt;b data-path-to-node=&quot;3,3,0&quot; data-index-in-node=&quot;118&quot;&gt;schwierigem Gelände&lt;/b&gt;.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,4,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;3,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Kälte:&lt;/b&gt; Das Wasser ist extrem kalt (Gefahr von Erschöpfung durch Kälte).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;2. Die Truhe (Das Ziel)&lt;/font&gt;&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Fundort:&lt;/b&gt; Eine im Boden eingelassene Steintruhe befindet sich unter Wasser an der Rückwand.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Entdeckung:&lt;/b&gt; Erfordert eine &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;27&quot;&gt;passive Wahrnehmung von 11&lt;/b&gt; oder höher.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,2,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;5,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Zustand:&lt;/b&gt; Die Truhe ist verschlossen (kann mit Ferols Schlüssel oder durch Knacken/Gewalt geöffnet werden).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;6&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;3. Beute &amp;amp; Heilmittel&lt;/font&gt;&lt;/b&gt;&lt;/h4&gt;&lt;p data-path-to-node=&quot;7&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Die Truhe ist zum Schutz mit feinem Sand gefüllt und enthält:&lt;/font&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;8&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,0,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;8,0,0&quot; data-index-in-node=&quot;0&quot;&gt;20 Dosen des Heilmittels gegen Frostleid (Frigid Woe Antidote):&lt;/b&gt; Genug, um die Mission erfolgreich abzuschließen.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;8,1,0&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b data-path-to-node=&quot;8,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Ein Ersatzauge (Ersatz Eye):&lt;/b&gt; Ein magisches Item (Prothese), das ein verlorenes Auge ersetzt.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="530" width="560" x="2980" y="10760" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-109" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 data-path-to-node=&quot;1&quot;&gt;&lt;b data-path-to-node=&quot;1&quot; data-index-in-node=&quot;0&quot;&gt;Das Ende der Reise: Rückkehr und Belohnung&lt;/b&gt;&lt;/h3&gt;&lt;h4 data-path-to-node=&quot;2&quot;&gt;&lt;b data-path-to-node=&quot;2&quot; data-index-in-node=&quot;0&quot;&gt;1. Der Rückweg nach Syrinlya&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;3&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;3,0,0&quot;&gt;&lt;b data-path-to-node=&quot;3,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Optionale Begegnungen:&lt;/b&gt; Du kannst entweder Zufallsbegegnungen für den Rückweg auswürfeln oder die Gruppe zur Belohnung für den Erfolg eine ereignislose, sichere Reise erleben lassen.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;4&quot;&gt;&lt;b data-path-to-node=&quot;4&quot; data-index-in-node=&quot;0&quot;&gt;2. Ablieferung des Heilmittels&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;5&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;Sobald die Charaktere wieder in &lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;32&quot;&gt;Syrinlya&lt;/b&gt; ankommen, arrangiert &lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;62&quot;&gt;„The Buyer“&lt;/b&gt; (der Käufer), dass das Gegenmittel per Teleportation direkt nach &lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;139&quot;&gt;Palebank Village&lt;/b&gt; geschickt wird.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,1,0&quot;&gt;&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Bezahlung:&lt;/b&gt; Der Elf händigt den Charakteren im Namen von Elro Aldataur die versprochene Belohnung von &lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;101&quot;&gt;200 Goldstücken (gp)&lt;/b&gt; aus.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h4 data-path-to-node=&quot;6&quot;&gt;&lt;b data-path-to-node=&quot;6&quot; data-index-in-node=&quot;0&quot;&gt;3. Mögliche Ausgänge&lt;/b&gt;&lt;/h4&gt;&lt;ul data-path-to-node=&quot;7&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,0,0&quot;&gt;&lt;b data-path-to-node=&quot;7,0,0&quot; data-index-in-node=&quot;0&quot;&gt;Erfolg:&lt;/b&gt; Die Gruppe rettet Irven und seine Familie. Sie erhalten den tiefen Dank von Elro, der Familie, den Bewohnern von Palebank Village und den Entdeckern in Syrinlya.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;7,1,0&quot;&gt;&lt;b data-path-to-node=&quot;7,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Misserfolg:&lt;/b&gt; Sollten die Charaktere zu lange gebraucht haben oder das Heilmittel nicht finden, erliegen alle vier Familienmitglieder der Krankheit.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="410" width="560" x="1930" y="12170" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-110" parent="1" style="whiteSpace=wrap;html=1;" value="Abschluss" vertex="1">
          <mxGeometry height="60" width="120" x="1640" y="12070" as="geometry" />
        </mxCell>
        <mxCell id="bB0-X0oldWWfwmH7fZuz-111" edge="1" parent="1" source="bB0-X0oldWWfwmH7fZuz-109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="12375" />
              <mxPoint x="380" y="6195" />
            </Array>
            <mxPoint x="1900" y="6195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="https://www.dndbeyond.com/monsters/744310-ferol-sal" link="https://www.dndbeyond.com/monsters/744310-ferol-sal" id="bB0-X0oldWWfwmH7fZuz-112">
          <mxCell parent="1" style="text;whiteSpace=wrap;" vertex="1">
