              <mxPoint x="110" y="7015" />
              <mxPoint x="110" y="835" />
            </Array>
            <mxPoint x="1630" y="835" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="https://www.dndbeyond.com/monsters/744310-ferol-sal" link="https://www.dndbeyond.com/monsters/744310-ferol-sal" id="SX3OvWbDw9Tligs5bd2K-74">
          <mxCell parent="1" style="text;whiteSpace=wrap;" vertex="1">
