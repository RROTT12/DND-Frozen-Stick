        </mxCell>
        <mxCell id="49YRu3OvXxTLOLlixWwz-147" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value=" " vertex="1">
          <mxGeometry height="30" width="410" x="6930" y="5350" as="geometry" />
        </mxCell>
        <mxCell id="49YRu3OvXxTLOLlixWwz-148" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Der Kaufer sitzt wie sonst&amp;nbsp; auch mit seinem kleine familar in dem haupt zelt das zelt sieht noch kaotischer aus als zuvor&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(wenn die 10 abenteruer zueruck geschikt wurden) sieht der kaufer etwas ausgeruhter aus als wie sie ihn zu vor sahen&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;das zelt wurde massigst umgestalte um medizing zu produziren&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;je nach dem wann sie ankommen ist er grade einen brif fuers festlant am schreieben oder grade dabei in einem buch Medizin fuer anfaenger rezept an nach produziren&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="430" x="5970" y="3590" as="geometry" />
        </mxCell>
        <mxCell id="MzNWKo_IKNj_6AbJ1x4_-2" edge="1" parent="1" source="49YRu3OvXxTLOLlixWwz-149" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="MzNWKo_IKNj_6AbJ1x4_-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="49YRu3OvXxTLOLlixWwz-149" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Die Schiffs reise an sich bestreiten sie auf dem sleben schif mit dem sie herkammen Kaufer und Andere bitten sie doch ob sie die verwundenten mit nehmen koennen da zwar ein auf bitten ein weiters schiff mit foraeten auf dem weg sei (welches auch die ander verwundent mitnehmen soll und weiter abenteure und freiwille vom festlannt mit nimmt)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;aber dies nich einige tage bennoetigt und sie bitte die die wollen und schwer verlzten schon mitnehmen oder Verstoerten&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="320" x="6280" y="11790" as="geometry" />
        </mxCell>
